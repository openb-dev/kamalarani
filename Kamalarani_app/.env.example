# Application Server Configuration
PORT=4000
SESSION_SECRET=kamalarani-secret-key-change-this

# Database Connection (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=kamalarani_db

# Google Analytics Configuration
# 1. Client-Side GA Tracking Measurement ID (e.g. G-XXXXXXXXXX)
GA_MEASUREMENT_ID=

# 2. Google Analytics Data API (Server-Side metrics fetch)
# GA4 Property ID (numeric, e.g. 123456789)
GA_PROPERTY_ID=
# Service Account Client Email
GA_CLIENT_EMAIL=
# Service Account Private Key (paste full string with \n)
GA_PRIVATE_KEY=
