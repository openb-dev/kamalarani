        <div class="field">
          <label for="branch">Branch *</label>
          <select id="branch" name="branch" required>
            <option value="">Select Branch</option>
            <option value="Coochbehar">Coochbehar</option>
            <option value="Kolkata">Kolkata</option>
          </select>
        </div>
        <div class="field"><label for="fatherName">Father's Name *</label><input type="text" id="fatherName" name="father_name" required placeholder="Father's full name"></div>
        <div class="field"><label for="motherName">Mother's Name *</label><input type="text" id="motherName" name="mother_name" required placeholder="Mother's full name"></div>
        <div class="field"><label for="occupation">Father's / Guardian's Occupation *</label><input type="text" id="occupation" name="occupation" required placeholder="e.g. Business, Service, Farmer, Teacher"></div>
        <div class="field"><label for="mobile">Parent's Mobile No. *</label><input type="tel" id="mobile" name="parent_mobile" required pattern="^(\+91[\-\s]?)?[0]?[6-9]\d{9}$" title="Please enter a valid 10-digit mobile number starting with 6, 7, 8, or 9 (e.g. 9876543210)" placeholder="e.g. 9876543210" autocomplete="tel"></div>
        <div class="field"><label for="email">Email ID (Optional)</label><input type="email" id="email" name="email" autocomplete="email" placeholder="e.g. parent@gmail.com (optional)"></div>
        <div class="field"><label for="aadhaarNo">Student Aadhaar No. (Optional)</label><input type="text" id="aadhaarNo" name="aadhaar_no" placeholder="12-digit Aadhaar number"></div>

