<!-- ── Admission Success Modal Popup ──────────────────────────── -->
<div id="admissionModal" style="display:none; position:fixed; inset:0; z-index:99999; background:rgba(20,14,10,0.75); backdrop-filter:blur(6px); align-items:center; justify-content:center; padding:18px;">
  <div style="background:#FFFDF8; border:2px solid var(--marigold); border-radius:20px; max-width:520px; width:100%; padding:32px 28px; box-shadow:0 24px 60px rgba(0,0,0,0.4); text-align:center; position:relative; font-family:'Manrope',sans-serif;">
    <button type="button" id="closeModalCross" style="position:absolute; top:16px; right:16px; background:none; border:none; font-size:1.6rem; cursor:pointer; color:var(--ink-soft);">&times;</button>
    <div style="font-size:3.4rem; margin-bottom:8px;">🎉</div>
    <h3 style="font-size:1.45rem; color:var(--vermilion); font-weight:800; margin-bottom:6px; font-family:'Fraunces',serif;">Application Submitted Successfully!</h3>
    <p style="font-size:0.92rem; color:var(--ink-soft); margin-bottom:20px;">Thank you for enrolling your child in Kamalarani Foundation Free Art &amp; Music Classes.</p>

    <div style="background:var(--temple-cream); border:1px dashed var(--gold-line); border-radius:14px; padding:18px; margin-bottom:24px; text-align:left;">
      <div style="display:flex; justify-content:space-between; margin-bottom:8px; font-size:0.9rem;">
        <span style="color:var(--ink-soft); font-weight:600;">Application Ref. No. (ARN):</span>
        <strong id="modalArn" style="color:var(--vermilion); font-family:monospace; font-size:1.05rem;">KFA-2026-0001</strong>
      </div>
      <div style="display:flex; justify-content:space-between; margin-bottom:8px; font-size:0.88rem;">
        <span style="color:var(--ink-soft);">Student Name:</span>
        <strong id="modalStudentName" style="color:var(--ink);">—</strong>
      </div>
      <div style="display:flex; justify-content:space-between; font-size:0.88rem;">
        <span style="color:var(--ink-soft);">Class &amp; Programme:</span>
        <strong id="modalClassProgramme" style="color:var(--ink);">—</strong>
      </div>
    </div>

    <div style="display:flex; gap:12px; flex-wrap:wrap; justify-content:center;">
      <a id="modalDownloadBtn" href="#" target="_blank" class="adm-submit" style="display:inline-flex; align-items:center; gap:8px; text-decoration:none; padding:12px 24px; margin:0; font-size:0.92rem; border-radius:999px;">
        📄 Print / Download Admission PDF
      </a>
      <button type="button" id="modalCloseBtn" style="padding:12px 24px; border-radius:999px; border:1.5px solid var(--ink-soft); background:transparent; font-weight:700; color:var(--ink); cursor:pointer;">
        Done
      </button>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('admissionForm');
  const modal = document.getElementById('admissionModal');
  if (!form || !modal) return;

  const submitBtn = document.getElementById('admitSubmitBtn');
  const modalArn = document.getElementById('modalArn');
  const modalStudentName = document.getElementById('modalStudentName');
  const modalClassProgramme = document.getElementById('modalClassProgramme');
  const modalDownloadBtn = document.getElementById('modalDownloadBtn');
  const modalCloseBtn = document.getElementById('modalCloseBtn');
  const closeModalCross = document.getElementById('closeModalCross');

  const progSelect = document.getElementById('programme');
  const progWrap   = document.getElementById('programmeDetailsWrap');
  const progInput  = document.getElementById('programmeDetails');

  function toggleProgrammeDetails() {
    if (!progSelect || !progWrap || !progInput) return;
    const val = progSelect.value;
    if (val === 'Cultural Programme' || val === 'Other Programmes') {
      progWrap.style.display = 'block';
      progInput.required = true;
    } else {
      progWrap.style.display = 'none';
      progInput.required = false;
      progInput.value = '';
    }
  }
  if (progSelect) {
    progSelect.addEventListener('change', toggleProgrammeDetails);
    toggleProgrammeDetails();
  }

  function closeModal() {
    modal.style.display = 'none';
    form.reset();
    toggleProgrammeDetails();
  }

  if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
  if (closeModalCross) closeModalCross.addEventListener('click', closeModal);
  modal.addEventListener('click', function(e) {
    if (e.target === modal) closeModal();
  });

  form.addEventListener('submit', async function(e) {
    e.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const origBtnText = submitBtn ? submitBtn.innerText : 'Submit Application & Generate Form PDF';
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerText = 'Submitting & Generating PDF...';
    }

    try {
      const formData = new FormData(form);
      const res = await fetch('/admissions', {
        method: 'POST',
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'Accept': 'application/json'
        },
        body: formData
      });

      const raw = await res.text();
      let data = null;
      try {
        data = raw ? JSON.parse(raw) : null;
      } catch (_) {
        console.error('Admission submit non-JSON response:', res.status, raw.slice(0, 400));
        alert('Server error while submitting (status ' + res.status + '). Please try again.');
        return;
      }

      if (data && data.success) {
        if (modalArn) modalArn.innerText = data.arn || '';
        if (modalStudentName) modalStudentName.innerText = data.student_name || '';
        if (modalClassProgramme) modalClassProgramme.innerText = (data.class_applying_for || '') + ' — ' + (data.programme || '');
        if (modalDownloadBtn) modalDownloadBtn.href = data.downloadUrl || '#';

        modal.style.display = 'flex';
        if (window.reapplyLanguage) window.reapplyLanguage();
      } else {
        alert((data && data.message) || 'Submission failed. Please check your form details.');
      }
    } catch (err) {
      console.error('Admission submit error:', err);
      alert(err.message || 'Could not submit application. Please check network connection and try again.');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerText = origBtnText;
      }
    }
  });
});
</script>

