  "foundingDate": "2022",
  "legalName": "Kamalarani Foundation",
  "taxID": "AAETK689KE20221",
  "email": "kamalaranifoundation17@gmail.com",
  "telephone": ["+917980350454", "+919123902781"],
  "address": [
    {
      "@type": "PostalAddress",
      "streetAddress": "Village: Panisala, P.O. Chhat Baro Chowki, P.S. Tufanganj",
      "addressLocality": "Coochbehar",
      "addressRegion": "West Bengal",
      "postalCode": "736160",
      "addressCountry": "IN"
    },
    {
      "@type": "PostalAddress",
      "streetAddress": "PNA 257/1, Polenite, Sardarpara, Barokapat, Salt Lake Sector-V",
      "addressLocality": "Kolkata",
      "addressRegion": "West Bengal",
      "postalCode": "700102",
      "addressCountry": "IN"
