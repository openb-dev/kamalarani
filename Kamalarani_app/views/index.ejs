        </div>
        <div class="field full">
          <label for="idProof">Identity Proof (Aadhaar Card / Birth Certificate) *</label>
          <input type="file" id="idProof" name="id_proof" accept="image/jpeg,image/jpg,image/png,image/webp,application/pdf" required style="padding: 10px; background: var(--white); border: 1.5px dashed var(--gold-line); border-radius: 8px; cursor: pointer; width: 100%;">
