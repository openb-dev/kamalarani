<link rel="stylesheet" href="/css/style.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
</head>
<body>
<a href="#main-content" class="skip-link">Skip to main content</a>

<%- include('partials/header') %>

<main id="main-content">

<section class="hero" aria-label="Hero section">
  <div class="hero-slider" id="heroSlider">
    <div class="hero-slides-wrapper">
      <!-- Slide 1: Promoting Sanatan Culture -->
      <div class="hero-slide active" data-slide="0">
        <div class="hero-grid">
          <div>
            <div class="eyebrow">Jay Shree Radha Govinda</div>
            <h1>Promoting <em>Sanatani</em> culture and heritage statewide, and advancing social welfare for the community.</h1>
            <p class="lede">Kamalarani Foundation is dedicated to preserving, propagating, and celebrating timeless Sanatani culture, heritage, and values across West Bengal.</p>
            <div class="hero-actions">
              <a href="#about" class="btn btn-primary" aria-label="Learn about our Sanatani mission">Our Mission</a>
              <a href="#support" class="btn btn-ghost" aria-label="Donate to support our work">Donate</a>
            </div>
            <div class="hero-stats">
              <div class="stat"><b>2</b><span>Active Centres</span></div>
              <div class="stat"><b>100%</b><span>Free of Cost</span></div>
              <div class="stat"><b>15+</b><span>Volunteers &amp; Team</span></div>
            </div>
          </div>
          <div class="hero-visual" style="background: #FAF1CD;">
            <img src="/images/temple.jpeg" alt="Sri Sri Radha-Govinda Thakurbari Temple, Natabari — Kamalarani Foundation" width="600" height="750" loading="eager" style="object-fit: cover; width: 100%; height: 100%;">
            <div class="hero-badge">Sri Sri Radha-Govinda Thakurbari — Natabari</div>
          </div>
        </div>
      </div>

      <!-- Slide 2: Promoting Free Art & Music Classes -->
      <div class="hero-slide" data-slide="1">
        <div class="hero-grid">
          <div>
            <div class="eyebrow">Free Art &amp; Music Education · West Bengal</div>
            <h1>Empowering village children with free <em>Art &amp; Music</em> classes.</h1>
            <p class="lede">Providing free drawing books, colors, music mentorship, and learning supplies for children in rural West Bengal — because every child deserves a chance to learn and grow.</p>
            <div class="hero-actions">
              <a href="#admission" class="btn btn-primary" aria-label="Enroll a child in free art classes">Enroll a Child</a>
              <a href="#support" class="btn btn-ghost" aria-label="Support free education for children">Donate</a>
            </div>
            <div class="hero-stats">
              <div class="stat"><b>100%</b><span>Free Materials</span></div>
              <div class="stat"><b>Class VIII</b><span>Nursery to Class VIII</span></div>
              <div class="stat"><b>Weekly</b><span>Art &amp; Music Sessions</span></div>
            </div>
          </div>
          <div class="hero-visual" style="background: #FAF1CD;">
            <img src="/images/children_drawings_temple.jpg" alt="Village children displaying artwork at Kamalarani Foundation art class" width="600" height="750" loading="eager" style="object-fit: cover; width: 100%; height: 100%;">
            <div class="hero-badge">Free Art Classes — Sri Sri Radha-Govinda Thakurbari</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Navigation Arrows -->
    <button class="slider-arrow prev-arrow" id="heroPrevBtn" aria-label="Previous slide">‹</button>
    <button class="slider-arrow next-arrow" id="heroNextBtn" aria-label="Next slide">›</button>

    <!-- Slide Indicators -->
    <div class="slider-dots" id="heroDots">
      <button class="dot active" data-goto="0" aria-label="Slide 1: Promoting Sanatani Culture"></button>
      <button class="dot" data-goto="1" aria-label="Slide 2: Free Art &amp; Music Classes"></button>
    </div>
  </div>
</section>

<section class="about" id="about" aria-labelledby="about-heading">
  <div class="wrap about-grid">
    <div class="about-img">
      <img src="/images/temple.jpeg" alt="Sri Sri Radha-Govinda Thakurbari, Natabari — venue for Kamalarani Foundation art classes" loading="lazy">
    </div>
    <div class="about-copy">
      <h2 id="about-heading">Our Mission</h2>
      <p>Kamalarani Foundation was founded to support the creative development, education, and future of children in rural West Bengal. We believe a child's circumstances should never limit their access to learning.</p>
      <div class="quote-block">"To bring the light of education, creativity, and a beautiful future into every child's hands."</div>
      <p><strong>Our Agenda:</strong> To promote and propagate Sanatani culture and values across the state, and to work towards the social welfare and upliftment of the community.</p>
      <p>Our free art classes began at the Sri Sri Radha-Govinda Thakurbari in Natabari, Coochbehar, and we're steadily expanding into further skill-development and educational programmes for children, step by step.</p>
      <span class="reg-tag">Registration No. AAETK689KE20221</span>
    </div>
  </div>
</section>

<section class="offer" aria-labelledby="whatwedo-heading">
  <div class="wrap">
    <div class="section-head">
      <h2 id="whatwedo-heading">What We Do</h2>
      <p>Simple, consistent support that meets children where they are.</p>
    </div>
    <div class="offer-grid">
      <div class="offer-card">
        <div class="offer-icon" aria-hidden="true">🎨</div>
        <h3>Free Art Classes</h3>
        <p>Weekly drawing and painting classes for children from Nursery to Class VIII, taught by dedicated volunteer teachers.</p>
      </div>
      <div class="offer-card">
        <div class="offer-icon" aria-hidden="true">📚</div>
        <h3>Educational Support</h3>
        <p>Educational and skill-development classes are being introduced step by step to support each child's all-round growth.</p>
      </div>
      <div class="offer-card">
        <div class="offer-icon" aria-hidden="true">🎒</div>
        <h3>Free Materials</h3>
        <p>Every enrolled child receives drawing books, pencils, erasers, sharpeners, pencil boxes, and colour kits at no cost.</p>
      </div>
    </div>
  </div>
</section>

<section class="events" id="events" aria-labelledby="events-heading">
  <div class="wrap">
    <div class="section-head">
      <h2 id="events-heading">Upcoming Events</h2>
      <p>What's happening next at Kamalarani Foundation.</p>
    </div>
    <% if (events && events.length) { %>
      <div class="offer-grid">
        <% events.forEach(function(ev){ %>
          <article class="offer-card">
            <h3><%= ev.title %></h3>
            <p><time datetime="<%= new Date(ev.event_date).toISOString() %>"><%= new Date(ev.event_date).toLocaleDateString('en-IN', { day:'numeric', month:'long', year:'numeric' }) %></time><% if (ev.location) { %> · <span><%= ev.location %></span><% } %></p>
            <% if (ev.description) { %><p><%= ev.description %></p><% } %>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <p style="text-align:center;color:var(--ink-soft);">No upcoming events right now — check back soon or <a href="/calendar">view the full calendar</a>.</p>
    <% } %>
    <div style="text-align:center;margin-top:28px;">
      <a href="/calendar" class="btn btn-ghost">View Full Event Calendar →</a>
    </div>
  </div>
</section>

<section class="gallery" id="gallery" aria-labelledby="gallery-heading">
  <div class="wrap">
    <div class="section-head">
      <h2 id="gallery-heading">From Our Classes</h2>
      <p>Moments from our free art classes and material distribution days.</p>
    </div>
    <% if (gallery && gallery.length) { %>
      <div class="gallery-grid">
        <% gallery.slice(0, 6).forEach(function(item){ %>
          <a href="/gallery" aria-label="<%= item.caption || 'Gallery photo from Kamalarani Foundation' %>">
            <% if (item.media_type === 'video') { %>
              <video src="<%= item.media_url %>" muted preload="none"></video>
            <% } else { %>
              <img src="<%= item.media_url %>" alt="<%= item.caption || 'Kamalarani Foundation free art class photo' %>" loading="lazy">
            <% } %>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="gallery-grid">
        <a href="/gallery" aria-label="Group photo with teacher and students">
          <img src="/images/photo4.jpeg" alt="Kamalarani Foundation — group photo with teacher and students" loading="lazy">
        </a>
        <a href="/gallery" aria-label="Children receiving art supplies">
          <img src="/images/photo1.jpeg" alt="Kamalarani Foundation — children receiving art supplies" loading="lazy">
        </a>
        <a href="/gallery" aria-label="Students with drawing kits">
          <img src="/images/photo3.jpeg" alt="Kamalarani Foundation — students with drawing kits" loading="lazy">
        </a>
        <a href="/gallery" aria-label="Volunteer distributing supplies to children">
          <img src="/images/photo5.jpeg" alt="Kamalarani Foundation — volunteer distributing art supplies to children" loading="lazy">
        </a>
        <a href="/gallery" aria-label="Teacher with young students">
          <img src="/images/photo2.jpeg" alt="Kamalarani Foundation — teacher with young students at free art class" loading="lazy">
        </a>
        <a href="/gallery" aria-label="Thakurbari class venue">
          <img src="/images/temple.jpeg" alt="Sri Sri Radha-Govinda Thakurbari — Kamalarani Foundation class venue" loading="lazy">
        </a>
      </div>
    <% } %>
    <div style="text-align:center;margin-top:28px;">
      <a href="/gallery" class="btn btn-ghost">View Full Gallery →</a>
    </div>
  </div>
</section>

<section class="team" id="team" aria-labelledby="team-heading">
  <div class="wrap">
    <div class="section-head">
      <h2 id="team-heading">Our Team</h2>
      <p>The people guiding Kamalarani Foundation's work, together with our teaching volunteers.</p>
    </div>
    <div class="team-grid">
      <div class="team-card">
        <div class="team-avatar" aria-hidden="true">SD</div>
        <h3>Snata Das</h3>
        <span>President</span>
      </div>
      <div class="team-card">
        <div class="team-avatar" aria-hidden="true">ND</div>
        <h3>Nishi Das</h3>
        <span>Secretary</span>
      </div>
      <div class="team-card">
        <div class="team-avatar" aria-hidden="true">BD</div>
        <h3>Beauti Das</h3>
        <span>Treasurer</span>
      </div>
    </div>

    <div class="team-role-title">Teaching Volunteers</div>
    <div class="members-list">
      <span>Sanjib Dolai — Art Teacher</span>
      <span>Beauti Das — Art Teacher</span>
      <span>Tumpa Roy — Art Teacher</span>
      <span>Nupur Pal — Art Teacher</span>
    </div>

    <div class="team-role-title">Kolkata Members</div>
    <div class="members-list">
      <span>Sushanta Das</span><span>Bappa Tanti</span><span>Nikhil Sardar</span>
      <span>Sanjib Dolai</span><span>Sanjay Rana</span><span>Ranjit Sardar</span>
      <span>Bijay Sardar</span><span>Rahul Singh</span><span>Raja Singh</span>
      <span>Sanju Singh</span><span>Prabir Sardar</span><span>Debasish Sardar</span>
    </div>
  </div>
</section>

<section class="admission" id="admission" aria-labelledby="admission-heading">
  <div class="wrap">
    <div class="admission-wrap">
      <div class="admission-info">
        <h2 id="admission-heading">Enrol Your Child</h2>
        <p>Free enrolment for children from Nursery to Class VIII in our Art and Music programmes. Fill in the form and our team will confirm your child's spot.</p>
        <ul>
          <li>100% free — no admission fee</li>
          <li>Art &amp; Music classes available</li>
          <li>Drawing materials provided by the foundation</li>
          <li>Open to children Nursery – Class VIII</li>
          <li>Classes held at Sri Sri Radha-Govinda Thakurbari, Natabari</li>
        </ul>
      </div>
      <form class="adm-form" id="admissionForm" action="/admissions" method="POST" aria-label="Art class admission form">
        <% if (locals.success && locals.success.length) { %>
          <div class="flash flash-success full" role="alert"><% locals.success.forEach(function(msg){ %><p><%= msg %></p><% }) %></div>
        <% } %>
        <% if (locals.error && locals.error.length) { %>
          <div class="flash flash-error full" role="alert"><% locals.error.forEach(function(msg){ %><p><%= msg %></p><% }) %></div>
        <% } %>
        <div class="field"><label for="studentName">Student's Name *</label><input type="text" id="studentName" name="student_name" required autocomplete="name" placeholder="Full name of student"></div>
        <div class="field"><label for="dob">Date of Birth *</label><input type="date" id="dob" name="dob" required></div>
        <div class="field">
          <label for="gender">Gender *</label>
          <select id="gender" name="gender" required><option value="">Select Gender</option><option>Male</option><option>Female</option><option>Other</option></select>
        </div>
        <div class="field">
          <label for="classFor">Class Applying For *</label>
          <select id="classFor" name="class_applying_for" required>
            <option value="">Select Class</option>
            <option>Nursery</option>
            <option>KG</option>
            <option>Class I</option>
            <option>Class II</option>
            <option>Class III</option>
            <option>Class IV</option>
            <option>Class V</option>
            <option>Class VI</option>
            <option>Class VII</option>
            <option>Class VIII</option>
          </select>
        </div>
        <div class="field">
          <label for="programme">Programme *</label>
          <select id="programme" name="programme" required>
            <option value="">Select Programme</option>
            <option value="Art Class">🎨 Art Class</option>
            <option value="Music Class">🎵 Music Class</option>
            <option value="Both">🎨🎵 Both (Art &amp; Music)</option>
          </select>
        </div>
        <div class="field"><label for="fatherName">Father's Name *</label><input type="text" id="fatherName" name="father_name" required placeholder="Father's full name"></div>
        <div class="field"><label for="motherName">Mother's Name *</label><input type="text" id="motherName" name="mother_name" required placeholder="Mother's full name"></div>
        <div class="field"><label for="mobile">Parent's Mobile No. *</label><input type="tel" id="mobile" name="parent_mobile" required pattern="^(\+91[\-\s]?)?[0]?[6-9]\d{9}$" title="Please enter a valid 10-digit mobile number starting with 6, 7, 8, or 9 (e.g. 9876543210)" placeholder="e.g. 9876543210" autocomplete="tel"></div>
        <div class="field"><label for="email">Email ID (Optional)</label><input type="email" id="email" name="email" autocomplete="email" placeholder="e.g. parent@gmail.com (optional)"></div>
        <div class="field full"><label for="address">Residential Address *</label><input type="text" id="address" name="address" required placeholder="Village/Locality, P.O., P.S., District, PIN"></div>
        <p class="form-note">Bring an Aadhaar copy (if available) and a passport-size photo at the time of your first class.</p>
        <button type="submit" class="adm-submit" id="admitSubmitBtn">Submit Application</button>
      </form>
    </div>
  </div>
</section>

<section class="support" id="support" aria-labelledby="support-heading">
  <div class="wrap">
    <h2 id="support-heading">Support Kamalarani Foundation</h2>
    <p>Every contribution — time, materials, or funds — helps us reach more children with free art and education.</p>
    <div class="support-cards">
      <div class="support-card"><span class="num" aria-hidden="true">🎁</span><p>Donate art materials — drawing books, pencils, colour kits</p></div>
      <div class="support-card"><span class="num" aria-hidden="true">🙋</span><p>Volunteer as a teacher for our weekly classes</p></div>
      <div class="support-card"><span class="num" aria-hidden="true">🤝</span><p>Partner with us to expand into new villages</p></div>
    </div>
  </div>
</section>

<section class="contact" id="contact" aria-labelledby="contact-heading">
  <div class="wrap contact-grid">
    <div>
      <div class="section-head" style="text-align:left; margin-bottom:28px;">
        <h2 id="contact-heading">Get in Touch</h2>
        <p>Reach out for admissions, volunteering, or general enquiries.</p>
      </div>
      <address>
        <div class="contact-card">
          <h3>📍 Branch Office</h3>
          <p>PNA 257/1, Polenite, Sardarpara, Barokapat, Salt Lake Sector-V, P.O. Krishnapur, P.S. Electronic Complex, North 24 Parganas, Pin - 700102</p>
        </div>
        <div class="contact-card">
          <h3>🏠 Head Office</h3>
          <p>Village: Panisala, P.O. Chhat Baro Chowki, P.S. Tufanganj, District Coochbehar, Pin Code - 736160, West Bengal, India</p>
        </div>
        <div class="contact-card">
          <h3>📞 Contact Numbers</h3>
          <a href="tel:+917980350454">79803 50454</a>
          <a href="tel:+919123902781">91239 02781</a>
          <a href="tel:+919163969424">91639 69424</a>
        </div>
        <div class="contact-card">
          <h3>✉️ Email</h3>
          <a href="mailto:kamalaranifoundation17@gmail.com">kamalaranifoundation17@gmail.com</a>
        </div>
        <div class="contact-card">
          <h3>🌐 Follow Us</h3>
          <div class="social-links-wrap" style="margin-top:8px;">
            <a href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="Facebook">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="Instagram">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
          </div>
        </div>
      </address>
    </div>
    <form class="contact-form" id="contactForm" action="/contact" method="POST" aria-label="Contact form">
      <% if (locals.success && locals.success.length) { %>
        <div class="flash flash-success" role="alert"><% locals.success.forEach(function(msg){ %><p><%= msg %></p><% }) %></div>
      <% } %>
      <% if (locals.error && locals.error.length) { %>
        <div class="flash flash-error" role="alert"><% locals.error.forEach(function(msg){ %><p><%= msg %></p><% }) %></div>
      <% } %>
      <div class="field"><label for="cName">Your Name *</label><input type="text" id="cName" name="name" required autocomplete="name"></div>
      <div class="field"><label for="cEmail">Email *</label><input type="email" id="cEmail" name="email" required autocomplete="email"></div>
      <div class="field"><label for="cSubject">Subject</label><input type="text" id="cSubject" name="subject"></div>
      <div class="field"><label for="cMessage">Message / Suggestion / Feedback *</label><textarea id="cMessage" name="message" required rows="5" placeholder="Write your message, suggestion, or feedback here..."></textarea></div>
      <button type="submit" class="adm-submit" id="contactSubmitBtn">Send Message</button>
    </form>
  </div>
</section>

</main>

<%- include('partials/footer') %>

<script src="/js/script.js"></script>
</body>
</html>
