        <div class="field"><label for="villageLocality">Village / Locality *</label><input type="text" id="villageLocality" name="village_locality" required placeholder="Village or Locality name"></div>
        <div class="field"><label for="po">Post Office (P.O.) *</label><input type="text" id="po" name="po" required placeholder="P.O. name"></div>
        <div class="field"><label for="ps">Police Station (P.S.) *</label><input type="text" id="ps" name="ps" required placeholder="P.S. name"></div>
        <div class="field"><label for="district">District *</label><input type="text" id="district" name="district" required placeholder="District (e.g. Coochbehar)"></div>
        <div class="field"><label for="state">State *</label><input type="text" id="state" name="state" required value="West Bengal"></div>
        <div class="field"><label for="pinCode">PIN Code *</label><input type="text" id="pinCode" name="pin_code" required pattern="\d{6}" title="Please enter a valid 6-digit PIN code" placeholder="6-digit PIN Code (e.g. 736160)"></div>

        <div class="field full" style="margin-top:10px;margin-bottom:2px;"><h4 style="font-size:0.95rem;color:var(--vermilion);font-weight:700;">📄 Mandatory Documents Upload</h4></div>
        <div class="field full">
          <label for="passportPhoto">Student's Passport-Size Photo *</label>
          <input type="file" id="passportPhoto" name="passport_photo" accept="image/jpeg,image/jpg,image/png,image/webp" required style="padding: 10px; background: var(--white); border: 1.5px dashed var(--gold-line); border-radius: 8px; cursor: pointer; width: 100%;">
