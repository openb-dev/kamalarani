<meta property="og:url" content="https://kamalaranifoundation.org/">
<meta property="og:title" content="Kamalarani Foundation — Free Art & Education for Village Children">
<meta property="og:description" content="Free art classes and educational support for children in rural West Bengal. 100% free — no fees, all materials provided.">
<meta property="og:image" content="https://kamalaranifoundation.org/images/photo2.jpeg">
<meta property="og:locale" content="en_IN">
<meta property="og:site_name" content="Kamalarani Foundation">

