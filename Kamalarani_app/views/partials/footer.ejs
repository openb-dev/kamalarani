<!-- ── Floating Spiritual Contact Button ──────────────────────── -->
<style>
  .fab-wrap {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  /* round button */
  .fab-btn {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--vermilion);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 6px 24px rgba(178,58,47,0.55);
    transition: transform .25s, box-shadow .25s;
    position: relative;
    text-decoration: none;
    cursor: pointer;
    border: none;
  }
  .fab-btn:hover {
    transform: scale(1.08) translateY(-2px);
    box-shadow: 0 12px 32px rgba(178,58,47,0.75);
  }

  /* pulse ring */
  .fab-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    animation: om-pulse 2.8s ease-out infinite;
  }
  @keyframes om-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(178,58,47,0.5); }
    70%  { box-shadow: 0 0 0 18px rgba(178,58,47,0); }
    100% { box-shadow: 0 0 0 0 rgba(178,58,47,0); }
  }

  /* Om mandala SVG */
  .fab-btn svg {
    width: 42px;
    height: 42px;
    transition: transform .6s ease;
  }
  .fab-btn:hover svg {
    transform: rotate(30deg);
  }

  @media (max-width: 480px) {
    .fab-wrap { bottom: 18px; right: 16px; }
    .fab-btn  { width: 58px; height: 58px; }
    .fab-btn svg { width: 36px; height: 36px; }
  }
</style>

<div class="fab-wrap" id="fabWrap">
  <a href="/#contact" class="fab-btn" id="fabBtn" aria-label="Contact Kamalarani Foundation">
    <!-- Om (ॐ) Mandala SVG — Sanatani spiritual icon -->
    <svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <!-- 8 lotus petals — filled for visibility -->
      <g fill="rgba(255,253,248,0.30)" stroke="#FFFDF8" stroke-width="1.6">
        <ellipse cx="40" cy="9"  rx="5.5" ry="10" transform="rotate(0   40 40)"/>
        <ellipse cx="40" cy="9"  rx="5.5" ry="10" transform="rotate(45  40 40)"/>
        <ellipse cx="40" cy="9"  rx="5.5" ry="10" transform="rotate(90  40 40)"/>
        <ellipse cx="40" cy="9"  rx="5.5" ry="10" transform="rotate(135 40 40)"/>
        <ellipse cx="40" cy="9"  rx="5.5" ry="10" transform="rotate(180 40 40)"/>
        <ellipse cx="40" cy="9"  rx="5.5" ry="10" transform="rotate(225 40 40)"/>
        <ellipse cx="40" cy="9"  rx="5.5" ry="10" transform="rotate(270 40 40)"/>
        <ellipse cx="40" cy="9"  rx="5.5" ry="10" transform="rotate(315 40 40)"/>
      </g>

      <!-- Marigold ring border -->
      <circle cx="40" cy="40" r="19" fill="none" stroke="#E8912D" stroke-width="1.5" opacity="0.8"/>

      <!-- OM symbol — large and bold -->
      <text
        x="40" y="50"
        text-anchor="middle"
        font-size="30"
        font-family="serif"
        fill="#FFFDF8"
        font-weight="bold"
      >ॐ</text>
    </svg>
  </a>
</div>

