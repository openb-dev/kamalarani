<!DOCTYPE html>
<html lang="en" class="notranslate">
<head>
  <meta charset="UTF-8">
  <meta name="google" content="notranslate">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="apple-touch-icon" href="/images/icon-192.png">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#B23A2F">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="KF CMS">
  <meta name="robots" content="noindex, nofollow">
  <title>Events Manager — Kamalarani Foundation CMS</title>
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/pwa-register.js" defer></script>
</head>
<body>
<div class="admin-layout">
  <%- include('partials/sidebar') %>

  <div class="admin-main">
    <%
      var editEvent = locals.editEvent || null;
      var events = locals.events || [];

      function formatLocalDatetime(dateObj) {
        if (!dateObj) return '';
        const d = new Date(dateObj);
        if (isNaN(d.getTime())) return '';
        const pad = n => String(n).padStart(2, '0');
        return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
      }

      function formatDisplayDatetime(dateObj) {
        if (!dateObj) return '';
        const d = new Date(dateObj);
        if (isNaN(d.getTime())) return '';
        return d.toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' });
      }

      function attr(value) {
        return String(value == null ? '' : value)
          .replace(/&/g, '&amp;')
          .replace(/"/g, '&quot;')
          .replace(/</g, '&lt;');
      }
    %>
    <div class="admin-topbar">
      <div style="display:flex;align-items:center;gap:14px;">
        <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">☰</button>
        <span class="topbar-title">Events Manager</span>
      </div>
      <div class="topbar-right">
        <a href="/calendar" class="topbar-site-link" target="_blank">↗ View Calendar</a>
      </div>
    </div>

    <div class="admin-content">
      <% if (locals.success && locals.success.length) { %>
        <div class="flash-bar success">✅ <%= locals.success[0] %></div>
      <% } %>
      <% if (locals.error && locals.error.length) { %>
        <div class="flash-bar error">⚠️ <%= locals.error[0] %></div>
      <% } %>

      <div class="page-header">
        <div class="page-header-left">
          <h1>Events</h1>
          <p>Create, edit and manage upcoming events shown on the homepage and calendar page.</p>
        </div>
      </div>

      <div class="events-management-grid">
        <!-- Create / Edit Form Card -->
        <div class="card">
          <div class="card-header">
            <span class="card-title"><%= editEvent ? '✏️ Edit Event' : '➕ Add New Event' %></span>
            <% if (editEvent) { %>
              <a href="/admin/events" class="btn btn-ghost btn-sm">Cancel Edit</a>
            <% } %>
          </div>
          <div class="card-body">
            <% if (editEvent) { %>
              <form action="/admin/events/<%= editEvent.id %>?_method=PUT" method="POST" class="event-form-stack">
            <% } else { %>
              <form action="/admin/events" method="POST" class="event-form-stack">
            <% } %>
              <div class="field">
                <label for="evTitle">Event Title (English) *</label>
                <input type="text" id="evTitle" name="title" required
                  value="<%= editEvent ? editEvent.title : '' %>"
                  placeholder="e.g. Jhulan Yatra of Lord Sri Krishna">
              </div>

              <div class="field">
                <label for="evTitleBn">Event Title (Bengali)</label>
                <input type="text" id="evTitleBn" name="title_bn"
                  value="<%= editEvent ? (editEvent.title_bn || '') : '' %>"
                  placeholder="যেমন: ভগবান শ্রীকৃষ্ণের ঝুলন যাত্রা অনুষ্ঠান">
              </div>

              <div class="field">
                <label for="evDesc">Description (English)</label>
                <textarea id="evDesc" name="description" placeholder="Brief description of the event..."><%= editEvent ? (editEvent.description || '') : '' %></textarea>
              </div>

              <div class="field">
                <label for="evDescBn">Description (Bengali)</label>
                <textarea id="evDescBn" name="description_bn" placeholder="অনুষ্ঠানের সংক্ষিপ্ত বিবরণ..."><%= editEvent ? (editEvent.description_bn || '') : '' %></textarea>
              </div>

              <div class="datetime-grid">
                <div class="field">
                  <label for="evDate">Start Date & Time *</label>
                  <input type="datetime-local" id="evDate" name="event_date" required
                    value="<%= editEvent ? formatLocalDatetime(editEvent.event_date) : '' %>">
                </div>
                <div class="field">
                  <label for="evEnd">End Date & Time</label>
                  <input type="datetime-local" id="evEnd" name="end_date"
                    value="<%= editEvent && editEvent.end_date ? formatLocalDatetime(editEvent.end_date) : '' %>">
                </div>
              </div>

              <div class="field">
                <label for="evLocation">Location (English) *</label>
                <input type="text" id="evLocation" name="location" required
                  value="<%= editEvent ? (editEvent.location || '') : '' %>"
                  placeholder="e.g. Sri Sri Radha-Govinda Thakurbari, Natabari">
              </div>

              <div class="field">
                <label for="evLocationBn">Location (Bengali)</label>
                <input type="text" id="evLocationBn" name="location_bn"
                  value="<%= editEvent ? (editEvent.location_bn || '') : '' %>"
                  placeholder="যেমন: শ্রী শ্রী রাধা-গোবিন্দ ঠাকুরবাড়ি, নাটাবাড়ি">
              </div>

              <div class="checkbox-row-card">
                <input type="checkbox" id="evPublished" name="is_published"
                  <%= editEvent ? (editEvent.is_published ? 'checked' : '') : 'checked' %>>
                <label for="evPublished">Publish this event (visible on public calendar)</label>
              </div>

              <div class="form-actions" style="margin-top:8px;">
                <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">
                  <%= editEvent ? '💾 Save Changes' : '➕ Create Event' %>
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- Events List Card -->
        <div class="card">
          <div class="card-header">
            <span class="card-title">All Events (<%= events.length %>)</span>
          </div>
          <% if (events.length === 0) { %>
            <div class="empty-state">
              <div class="empty-icon">📅</div>
              <p>No events scheduled yet. Create your first event using the form.</p>
            </div>
          <% } else { %>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Title</th>
                    <th>Start / End</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th style="text-align:right;">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% events.forEach(ev => { %>
                    <tr class="<%= editEvent && editEvent.id === ev.id ? 'editing-row' : '' %>">
                      <td class="td-name td-truncate" style="max-width:180px;">
                        <button
                          type="button"
                          class="event-preview-btn event-view-btn"
                          title="View full event"
                          data-title="<%= attr(ev.title) %>"
                          data-title-bn="<%= attr(ev.title_bn) %>"
                          data-description="<%= attr(ev.description) %>"
                          data-description-bn="<%= attr(ev.description_bn) %>"
                          data-start="<%= attr(formatDisplayDatetime(ev.event_date)) %>"
                          data-end="<%= attr(formatDisplayDatetime(ev.end_date)) %>"
                          data-location="<%= attr(ev.location) %>"
                          data-location-bn="<%= attr(ev.location_bn) %>"
                          data-status="<%= ev.is_published ? 'Published' : 'Draft' %>"
                        ><%= ev.title %></button>
                      </td>
                      <td style="white-space:nowrap;font-size:0.82rem;">
                        <div>
                          <span style="color:var(--text-muted);font-size:0.7rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;">Start</span>
                          <div><strong><%= new Date(ev.event_date).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %></strong></div>
                          <div style="color:var(--text-muted);font-size:0.78rem;">
                            <%= new Date(ev.event_date).toLocaleTimeString('en-IN', { hour:'2-digit', minute:'2-digit' }) %>
                          </div>
                        </div>
                        <div style="margin-top:8px;">
                          <span style="color:var(--text-muted);font-size:0.7rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;">End</span>
                          <% if (ev.end_date) { %>
                            <div><strong><%= new Date(ev.end_date).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %></strong></div>
                            <div style="color:var(--text-muted);font-size:0.78rem;">
                              <%= new Date(ev.end_date).toLocaleTimeString('en-IN', { hour:'2-digit', minute:'2-digit' }) %>
                            </div>
                          <% } else { %>
                            <div style="color:var(--text-muted);">—</div>
                          <% } %>
                        </div>
                      </td>
                      <td class="td-truncate" style="max-width:160px;font-size:0.82rem;">
                        <%= ev.location || '—' %>
                      </td>
                      <td>
                        <span class="badge <%= ev.is_published ? 'badge-published' : 'badge-draft' %>">
                          <%= ev.is_published ? 'Published' : 'Draft' %>
                        </span>
                      </td>
                      <td style="text-align:right;">
                        <div style="display:inline-flex;gap:6px;flex-wrap:wrap;justify-content:flex-end;">
                          <button
                            type="button"
                            class="btn btn-primary btn-sm event-view-btn"
                            data-title="<%= attr(ev.title) %>"
                            data-title-bn="<%= attr(ev.title_bn) %>"
                            data-description="<%= attr(ev.description) %>"
                            data-description-bn="<%= attr(ev.description_bn) %>"
                            data-start="<%= attr(formatDisplayDatetime(ev.event_date)) %>"
                            data-end="<%= attr(formatDisplayDatetime(ev.end_date)) %>"
                            data-location="<%= attr(ev.location) %>"
                            data-location-bn="<%= attr(ev.location_bn) %>"
                            data-status="<%= ev.is_published ? 'Published' : 'Draft' %>"
                          >View</button>
                          <a href="/admin/events/<%= ev.id %>/edit" class="btn btn-ghost btn-sm">✏️ Edit</a>
                          <form action="/admin/events/<%= ev.id %>?_method=DELETE" method="POST" style="display:inline;" onsubmit="return confirm('Delete this event?')">
                            <button type="submit" class="btn btn-danger btn-sm btn-icon" title="Delete">🗑</button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>
</div>

<dialog class="message-dialog" id="eventDialog" aria-labelledby="eventDialogTitle">
  <div class="message-dialog-header">
    <div>
      <div class="message-dialog-label">Event details</div>
      <h2 id="eventDialogTitle">Event</h2>
    </div>
    <button type="button" class="message-dialog-close" id="eventDialogClose" aria-label="Close event">✕</button>
  </div>
  <div class="message-dialog-meta">
    <div><strong>Title (Bengali):</strong> <span id="eventDialogTitleBn"></span></div>
    <div><strong>Start:</strong> <span id="eventDialogStart"></span></div>
    <div><strong>End:</strong> <span id="eventDialogEnd"></span></div>
    <div><strong>Location:</strong> <span id="eventDialogLocation"></span></div>
    <div><strong>Location (Bengali):</strong> <span id="eventDialogLocationBn"></span></div>
    <div><strong>Status:</strong> <span id="eventDialogStatus"></span></div>
  </div>
  <div class="message-dialog-body">
    <div class="event-dialog-section">
      <strong>Description (English)</strong>
      <p id="eventDialogDescription"></p>
    </div>
    <div class="event-dialog-section">
      <strong>Description (Bengali)</strong>
      <p id="eventDialogDescriptionBn"></p>
    </div>
  </div>
</dialog>

<script src="/js/admin.js"></script>
<script>
  (function () {
    const dialog = document.getElementById('eventDialog');
    const closeButton = document.getElementById('eventDialogClose');
    const title = document.getElementById('eventDialogTitle');
    const titleBn = document.getElementById('eventDialogTitleBn');
    const start = document.getElementById('eventDialogStart');
    const end = document.getElementById('eventDialogEnd');
    const location = document.getElementById('eventDialogLocation');
    const locationBn = document.getElementById('eventDialogLocationBn');
    const status = document.getElementById('eventDialogStatus');
    const description = document.getElementById('eventDialogDescription');
    const descriptionBn = document.getElementById('eventDialogDescriptionBn');

    function blank(value) {
      return value && value.trim() ? value : '—';
    }

    document.querySelectorAll('.event-view-btn').forEach(button => {
      button.addEventListener('click', () => {
        title.textContent = blank(button.dataset.title);
        titleBn.textContent = blank(button.dataset.titleBn);
        start.textContent = blank(button.dataset.start);
        end.textContent = blank(button.dataset.end);
        location.textContent = blank(button.dataset.location);
        locationBn.textContent = blank(button.dataset.locationBn);
        status.textContent = blank(button.dataset.status);
        description.textContent = blank(button.dataset.description);
        descriptionBn.textContent = blank(button.dataset.descriptionBn);
        dialog.showModal();
      });
    });

    closeButton.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', event => {
      if (event.target === dialog) dialog.close();
    });
  })();
</script>
</body>
</html>