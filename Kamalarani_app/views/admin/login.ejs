<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Admin Login — Kamalarani Foundation</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="login-page">
  <div class="login-card">
    <div class="login-logo">
      <img src="/images/logo.png" alt="Kamalarani Foundation Logo" class="login-logo-img">
      <div class="logo-text">
        <h2>Kamalarani Foundation</h2>
        <p>Content Management System</p>
      </div>
    </div>

    <h1>Welcome back</h1>
    <p class="login-sub">Sign in to manage your foundation's content.</p>

    <% if (locals.error && locals.error.length) { %>
      <div class="login-error">⚠️ <%= locals.error[0] %></div>
    <% } %>

    <form action="/admin/login" method="POST" novalidate>
      <div class="login-field">
        <label for="loginEmail">Email Address</label>
        <input type="email" id="loginEmail" name="email" placeholder="admin@kamalaranifoundation.org" required autocomplete="email">
      </div>
      <div class="login-field">
        <label for="loginPassword">Password</label>
        <input type="password" id="loginPassword" name="password" placeholder="••••••••••" required autocomplete="current-password">
      </div>
      <button type="submit" class="login-submit">Sign In to Dashboard</button>
    </form>

    <div class="login-back">
      <a href="/">← Back to main website</a>
    </div>
  </div>
</div>
</body>
</html>