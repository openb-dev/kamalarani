<!DOCTYPE html>
<html lang="en" class="notranslate">
<head>
  <meta charset="UTF-8">
  <meta name="google" content="notranslate">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="apple-touch-icon" href="/images/icon-192.png">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#B23A2F">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="KF CMS">
  <meta name="robots" content="noindex, nofollow">
  <title>Admissions — Kamalarani Foundation CMS</title>
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/pwa-register.js" defer></script>
  <style>
    .row-pending { background: rgba(240,192,64,0.04); }
    .editing-row { background: rgba(178,58,47,0.08) !important; font-weight: 500; }
    .print-only-header { display: none; }
    .table-wrap table th:nth-child(13) {
      padding-left: 78px;
    }
    .table-wrap table td:nth-child(13) {
      padding-left: 16px;
    }

    @media print {
      body {
        background: #fff !important;
        color: #111 !important;
        font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
      .admin-sidebar, .admin-topbar, .sidebar-toggle, .flash-bar, .page-header, .no-print, .card-header, #filterPillGroup, button, .btn,
      th:nth-child(2), td:nth-child(2),
      th:nth-child(4), td:nth-child(4),
      th:nth-child(11), td:nth-child(11),
      th:nth-child(13), td:nth-child(13) {
        display: none !important;
      }
      .admin-layout { display: block !important; }
      .admin-main { margin: 0 !important; padding: 0 !important; }
      .admin-content { padding: 0 !important; }
      .card { border: none !important; box-shadow: none !important; margin: 0 !important; padding: 0 !important; background: transparent !important; }
      .table-wrap { overflow: visible !important; }
      
      .print-only-header {
        display: block !important;
        text-align: center;
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 2px solid #B23A2F;
      }
      .print-only-header h1 {
        font-family: 'Fraunces', serif;
        font-size: 16pt;
        color: #B23A2F;
        margin: 0 0 2px 0;
        letter-spacing: 0.05em;
      }
      .print-only-header p {
        font-size: 8.5pt;
        color: #222;
        margin: 2px 0;
      }
      .print-report-meta {
        font-size: 7.5pt;
        color: #555;
        margin-top: 4px;
        font-weight: 600;
      }

      table {
        width: 100% !important;
        table-layout: fixed !important;
        border-collapse: collapse !important;
        font-size: 7.5pt !important;
      }
      thead {
        display: table-header-group !important;
      }
      tr {
        page-break-inside: avoid !important;
        break-inside: avoid !important;
      }
      tbody tr:nth-child(even) {
        background-color: #faf7f2 !important;
      }
      th, td {
        border: 1px solid #c0b4a5 !important;
        padding: 5px 6px !important;
        text-align: left !important;
        vertical-align: top !important;
        word-wrap: break-word !important;
        overflow-wrap: break-word !important;
        white-space: normal !important;
        color: #111 !important;
      }
      th {
        background: #f2e9dc !important;
        font-weight: 700 !important;
        color: #2b2118 !important;
        font-size: 7.5pt !important;
        text-transform: uppercase !important;
        letter-spacing: 0.04em !important;
        white-space: nowrap !important;
        padding: 6px 5px !important;
      }

      /* Landscape Column Width Ratios (default & when print-mode-landscape is set) */
      th:nth-child(1), td:nth-child(1) { width: 3.5%; text-align: center !important; font-weight: bold; } /* # */
      th:nth-child(3), td:nth-child(3) { width: 17.5%; } /* Student Name & ARN */
      th:nth-child(5), td:nth-child(5) { width: 9%; }   /* DOB/Gender */
      th:nth-child(6), td:nth-child(6) { width: 7%; text-align: center !important; }  /* Class */
      th:nth-child(7), td:nth-child(7) { width: 13%; }  /* Programme */
      th:nth-child(8), td:nth-child(8) { width: 9%; text-align: center !important; }  /* Branch */
      th:nth-child(9), td:nth-child(9) { width: 19%; }  /* Parents/Mobile/Aadhaar */
      th:nth-child(10), td:nth-child(10) { width: 14%; } /* Full Address */
      th:nth-child(12), td:nth-child(12) { width: 8%; display:table-cell !important; text-align: center !important; } /* Status */

      /* Portrait Column Width Ratios (when print-mode-portrait is set) */
      body.print-mode-portrait th, body.print-mode-portrait td { font-size: 6.8pt !important; padding: 4px 4px !important; }
      body.print-mode-portrait th:nth-child(1), body.print-mode-portrait td:nth-child(1) { width: 4%; text-align: center !important; font-weight: bold; }
      body.print-mode-portrait th:nth-child(3), body.print-mode-portrait td:nth-child(3) { width: 18%; }
      body.print-mode-portrait th:nth-child(5), body.print-mode-portrait td:nth-child(5) { width: 10%; }
      body.print-mode-portrait th:nth-child(6), body.print-mode-portrait td:nth-child(6) { width: 7%; text-align: center !important; }
      body.print-mode-portrait th:nth-child(7), body.print-mode-portrait td:nth-child(7) { width: 13%; }
      body.print-mode-portrait th:nth-child(8), body.print-mode-portrait td:nth-child(8) { width: 8%; text-align: center !important; }
      body.print-mode-portrait th:nth-child(9), body.print-mode-portrait td:nth-child(9) { width: 19%; }
      body.print-mode-portrait th:nth-child(10), body.print-mode-portrait td:nth-child(10) { width: 13%; }
      body.print-mode-portrait th:nth-child(12), body.print-mode-portrait td:nth-child(12) { width: 8%; display:table-cell !important; text-align: center !important; }
    }
  </style>
</head>
<body>
<div class="admin-layout">
  <%- include('partials/sidebar') %>

  <div class="admin-main">
    <%
      var editApp = locals.editApp || null;
      var apps = locals.apps || [];

      function formatLocalDateInput(dateObj) {
        if (!dateObj) return '';
        const d = new Date(dateObj);
        if (isNaN(d.getTime())) return '';
        const pad = n => String(n).padStart(2, '0');
        return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
      }
    %>
    <div class="admin-topbar">
      <div style="display:flex;align-items:center;gap:14px;">
        <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">☰</button>
        <span class="topbar-title">Admission Applications</span>
      </div>
      <div class="topbar-right">
        <span style="font-size:0.82rem;color:var(--text-secondary);"><%= apps.length %> total</span>
      </div>
    </div>

    <div class="admin-content">
      <!-- Printable Official Statement Header Banner -->
      <div class="print-only-header">
        <h1>KAMALARANI FOUNDATION</h1>
        <p style="font-size:11pt; font-weight:700; color:#111;">OFFICIAL ADMISSIONS SUMMARY STATEMENT &amp; ENROLMENT REPORT</p>
        <p class="print-report-meta">
          Registration No: AAETK689KE20221 &nbsp;|&nbsp;
          Generated On: <%= new Date().toLocaleDateString('en-IN', { day:'numeric', month:'long', year:'numeric' }) %> &nbsp;|&nbsp;
          Total Registered Students: <%= apps.length %>
        </p>
      </div>

      <% if (locals.success && locals.success.length) { %>
        <div class="flash-bar success">✅ <%= locals.success[0] %></div>
      <% } %>
      <% if (locals.error && locals.error.length) { %>
        <div class="flash-bar error">⚠️ <%= locals.error[0] %></div>
      <% } %>

      <div class="page-header">
        <div class="page-header-left">
          <h1>Admissions</h1>
          <p>Educational, Art &amp; Music class enrolment applications submitted through the public website.</p>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
          <% const pendingCount = apps.filter(a => a.status === 'pending').length; %>
          <% const approvedCount = apps.filter(a => a.status === 'approved').length; %>
          <% if (pendingCount > 0) { %>
            <span class="badge badge-pending" style="padding:6px 14px;font-size:0.8rem;"><%= pendingCount %> pending</span>
          <% } %>
          <% if (approvedCount > 0) { %>
            <span class="badge badge-approved" style="padding:6px 14px;font-size:0.8rem;"><%= approvedCount %> approved</span>
          <% } %>
        </div>
      </div>

      <!-- Edit Admission Application Card -->
      <% if (editApp) { %>
        <div class="card no-print" style="margin-bottom:24px; border:2px solid var(--vermilion); background:#fff;" id="editAdmissionCard">
          <div class="card-header" style="display:flex; justify-content:space-between; align-items:center; background: rgba(178, 58, 47, 0.05); border-bottom: 1px solid var(--border); padding: 14px 20px;">
            <span class="card-title" style="color:var(--vermilion); font-weight:700; font-size:1.05rem;">
              ✏️ Edit Admission Application — <%= editApp.arn || ('KFA-2026-' + String(editApp.id).padStart(4, '0')) %> (<%= editApp.student_name %>)
            </span>
            <a href="/admin/admissions" class="btn btn-ghost btn-sm">Cancel Edit</a>
          </div>
          <div class="card-body" style="padding:20px;">
            <form action="/admin/admissions/<%= editApp.id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="event-form-stack">
              
              <div style="font-size:0.82rem; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:var(--vermilion); margin-bottom:12px; border-bottom:1px solid var(--border); padding-bottom:4px;">
                1. Student Information
              </div>
              <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap:14px; margin-bottom:20px;">
                <div class="field">
                  <label for="edit_student_name">Student Full Name *</label>
                  <input type="text" id="edit_student_name" name="student_name" required value="<%= editApp.student_name || '' %>" placeholder="e.g. Rahul Das">
                </div>
                <div class="field">
                  <label for="edit_dob">Date of Birth *</label>
                  <input type="date" id="edit_dob" name="dob" required value="<%= formatLocalDateInput(editApp.dob) %>">
                </div>
                <div class="field">
                  <label for="edit_gender">Gender *</label>
                  <select id="edit_gender" name="gender" required>
                    <option value="">Select Gender</option>
                    <option value="Male" <%= editApp.gender === 'Male' ? 'selected' : '' %>>Male</option>
                    <option value="Female" <%= editApp.gender === 'Female' ? 'selected' : '' %>>Female</option>
                    <option value="Other" <%= editApp.gender === 'Other' ? 'selected' : '' %>>Other</option>
                  </select>
                </div>
                <div class="field">
                  <label for="edit_school_name">School Currently Attending</label>
                  <input type="text" id="edit_school_name" name="school_name" value="<%= editApp.school_name || '' %>" placeholder="e.g. Jenkins School">
                </div>
                <div class="field">
                  <label for="edit_class_applying_for">Class Applying For *</label>
                  <select id="edit_class_applying_for" name="class_applying_for" required>
                    <option value="">Select Class</option>
                    <% ['Nursery','KG','Class I','Class II','Class III','Class IV','Class V','Class VI','Class VII','Class VIII','Class IX','Class X','Class XI','Class XII','Graduation'].forEach(cls => { %>
                      <option value="<%= cls %>" <%= editApp.class_applying_for === cls ? 'selected' : '' %>><%= cls %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="field">
                  <label for="edit_programme">Programme *</label>
                  <select id="edit_programme" name="programme" required>
                    <option value="">Select Programme</option>
                    <% ['Art Class','Music Class','Both','Education Programme','Gita Gyaan','Cultural Programme','Other Programmes'].forEach(prog => { %>
                      <option value="<%= prog %>" <%= (editApp.programme || '').startsWith(prog) ? 'selected' : '' %>><%= prog %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="field">
                  <label for="edit_branch">Branch *</label>
                  <select id="edit_branch" name="branch" required>
                    <option value="Coochbehar" <%= editApp.branch === 'Coochbehar' ? 'selected' : '' %>>Coochbehar</option>
                    <option value="Kolkata" <%= editApp.branch === 'Kolkata' ? 'selected' : '' %>>Kolkata</option>
                  </select>
                </div>
                <div class="field">
                  <label for="edit_status">Application Status *</label>
                  <select id="edit_status" name="status" required style="font-weight:700; color:var(--vermilion);">
                    <option value="pending" <%= editApp.status === 'pending' ? 'selected' : '' %>>Pending</option>
                    <option value="approved" <%= editApp.status === 'approved' ? 'selected' : '' %>>Approved</option>
                    <option value="rejected" <%= editApp.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
                  </select>
                </div>
              </div>

              <div style="font-size:0.82rem; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:var(--vermilion); margin-bottom:12px; border-bottom:1px solid var(--border); padding-bottom:4px;">
                2. Parent &amp; Contact Details
              </div>
              <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap:14px; margin-bottom:20px;">
                <div class="field">
                  <label for="edit_father_name">Father's Name *</label>
                  <input type="text" id="edit_father_name" name="father_name" required value="<%= editApp.father_name || '' %>">
                </div>
                <div class="field">
                  <label for="edit_mother_name">Mother's Name *</label>
                  <input type="text" id="edit_mother_name" name="mother_name" required value="<%= editApp.mother_name || '' %>">
                </div>
                <div class="field">
                  <label for="edit_occupation">Father's / Guardian's Occupation *</label>
                  <input type="text" id="edit_occupation" name="occupation" required value="<%= editApp.occupation || '' %>">
                </div>
                <div class="field">
                  <label for="edit_parent_mobile">Primary Contact Mobile *</label>
                  <input type="tel" id="edit_parent_mobile" name="parent_mobile" required value="<%= editApp.parent_mobile || '' %>" placeholder="10-digit mobile number">
                </div>
                <div class="field">
                  <label for="edit_mother_mobile">Mother's Mobile</label>
                  <input type="tel" id="edit_mother_mobile" name="mother_mobile" value="<%= editApp.mother_mobile || '' %>">
                </div>
                <div class="field">
                  <label for="edit_email">Email Address</label>
                  <input type="email" id="edit_email" name="email" value="<%= editApp.email || '' %>">
                </div>
                <div class="field">
                  <label for="edit_aadhaar_no">Aadhaar Number</label>
                  <input type="text" id="edit_aadhaar_no" name="aadhaar_no" value="<%= editApp.aadhaar_no || '' %>">
                </div>
              </div>

              <div style="font-size:0.82rem; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:var(--vermilion); margin-bottom:12px; border-bottom:1px solid var(--border); padding-bottom:4px;">
                3. Address Details
              </div>
              <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap:14px; margin-bottom:20px;">
                <div class="field">
                  <label for="edit_village_locality">Village / Locality *</label>
                  <input type="text" id="edit_village_locality" name="village_locality" required value="<%= editApp.village_locality || '' %>">
                </div>
                <div class="field">
                  <label for="edit_po">Post Office (P.O.) *</label>
                  <input type="text" id="edit_po" name="po" required value="<%= editApp.po || '' %>">
                </div>
                <div class="field">
                  <label for="edit_ps">Police Station (P.S.) *</label>
                  <input type="text" id="edit_ps" name="ps" required value="<%= editApp.ps || '' %>">
                </div>
                <div class="field">
                  <label for="edit_district">District *</label>
                  <input type="text" id="edit_district" name="district" required value="<%= editApp.district || '' %>">
                </div>
                <div class="field">
                  <label for="edit_state">State *</label>
                  <input type="text" id="edit_state" name="state" required value="<%= editApp.state || 'West Bengal' %>">
                </div>
                <div class="field">
                  <label for="edit_pin_code">PIN Code *</label>
                  <input type="text" id="edit_pin_code" name="pin_code" required value="<%= editApp.pin_code || '' %>">
                </div>
              </div>

              <div style="font-size:0.82rem; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:var(--vermilion); margin-bottom:12px; border-bottom:1px solid var(--border); padding-bottom:4px;">
                4. Uploaded Documents (Optional Replace)
              </div>
              <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap:14px; margin-bottom:20px;">
                <div class="field">
                  <label for="edit_passport_photo">Passport Photo</label>
                  <% if (editApp.passport_photo) { %>
                    <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px;">
                      <img src="<%= editApp.passport_photo %>" alt="Current Photo" style="width:38px; height:46px; object-fit:cover; border-radius:4px; border:1px solid var(--border);">
                      <a href="<%= editApp.passport_photo %>" target="_blank" style="font-size:0.78rem; color:var(--info); font-weight:600;">View Photo ↗</a>
                    </div>
                  <% } %>
                  <input type="file" id="edit_passport_photo" name="passport_photo" accept="image/*">
                  <small style="color:var(--text-muted); font-size:0.75rem; display:block; margin-top:2px;">Leave empty to keep current photo.</small>
                </div>

                <div class="field">
                  <label for="edit_id_proof">Identity Proof (Aadhaar / Birth Cert)</label>
                  <% if (editApp.id_proof) { %>
                    <div style="margin-bottom:8px;">
                      <a href="<%= editApp.id_proof %>" target="_blank" style="font-size:0.78rem; color:var(--info); font-weight:600;">🪪 View Document ↗</a>
                    </div>
                  <% } %>
                  <input type="file" id="edit_id_proof" name="id_proof" accept="image/*,.pdf">
                  <small style="color:var(--text-muted); font-size:0.75rem; display:block; margin-top:2px;">Leave empty to keep current document.</small>
                </div>
              </div>

              <div style="display:flex; gap:12px; margin-top:24px;">
                <button type="submit" class="btn btn-primary" style="padding:10px 24px; font-weight:700;">💾 Save Changes</button>
                <a href="/admin/admissions" class="btn btn-ghost" style="padding:10px 20px;">Cancel Edit</a>
              </div>
            </form>
          </div>
        </div>
      <% } %>

      <!-- Admissions Summary & Analytics Report -->
      <%
        const totalApps = apps.length;
        const countArt = apps.filter(a => (a.programme || '').includes('Art Class')).length;
        const countMusic = apps.filter(a => (a.programme || '').includes('Music Class')).length;
        const countBoth = apps.filter(a => (a.programme || '').includes('Both')).length;
        const countEdu = apps.filter(a => (a.programme || '').includes('Education')).length;
        const countGita = apps.filter(a => (a.programme || '').includes('Gita Gyaan')).length;
        const countCultural = apps.filter(a => (a.programme || '').includes('Cultural')).length;
        const countOther = apps.filter(a => (a.programme || '').includes('Other')).length;

        const countCoochbehar = apps.filter(a => (a.branch || '').toLowerCase() === 'coochbehar').length;
        const countKolkata = apps.filter(a => (a.branch || '').toLowerCase() === 'kolkata').length;

        const countPending = apps.filter(a => a.status === 'pending').length;
        const countApproved = apps.filter(a => a.status === 'approved').length;
        const countRejected = apps.filter(a => a.status === 'rejected').length;
      %>

      <div class="card no-print" style="margin-bottom:24px; padding: 20px; background: #fff;">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:16px; border-bottom:1px solid #EFE4D2; padding-bottom:12px;">
          <div>
            <h3 style="font-size:1.15rem; margin:0; color:var(--text-primary); display:flex; align-items:center; gap:8px;">
              📊 <span>Admissions Summary Report &amp; Analytics</span>
            </h3>
            <p style="margin:4px 0 0 0; font-size:0.83rem; color:var(--text-secondary);" id="showingCount">
              Total Applications: <strong><%= totalApps %></strong> (Pending: <%= countPending %> | Approved: <%= countApproved %> | Rejected: <%= countRejected %>)
            </p>
          </div>
          <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
            <button type="button" onclick="printReport('portrait')" class="btn btn-outline" style="font-size:0.82rem; padding:6px 12px; display:inline-flex; align-items:center; gap:6px;">
              📄 <span>Print Portrait</span>
            </button>
            <button type="button" onclick="printReport('landscape')" class="btn btn-outline" style="font-size:0.82rem; padding:6px 12px; display:inline-flex; align-items:center; gap:6px;">
              🖼️ <span>Print Landscape</span>
            </button>
          </div>
        </div>

        <!-- Filter Pill Tabs -->
        <div style="display:flex; flex-wrap:wrap; gap:8px; margin-bottom:18px;" id="filterPillGroup">
          <button type="button" class="filter-pill active" data-filter="all">
            🌐 All (<%= totalApps %>)
          </button>
          <button type="button" class="filter-pill" data-filter="Art Class">
            🎨 Art Class (<%= countArt %>)
          </button>
          <button type="button" class="filter-pill" data-filter="Music Class">
            🎵 Music Class (<%= countMusic %>)
          </button>
          <button type="button" class="filter-pill" data-filter="Both">
            🎨🎵 Both (<%= countBoth %>)
          </button>
          <button type="button" class="filter-pill" data-filter="Education">
            📚 Education (<%= countEdu %>)
          </button>
          <button type="button" class="filter-pill" data-filter="Gita Gyaan">
            📖 Gita Gyaan (<%= countGita %>)
          </button>
          <button type="button" class="filter-pill" data-filter="Cultural">
            🎭 Cultural (<%= countCultural %>)
          </button>
          <button type="button" class="filter-pill" data-filter="Other">
            ✨ Other (<%= countOther %>)
          </button>
        </div>

        <!-- Stat Cards Grid Row -->
        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap:12px;">
          <div style="background:#FDFBF7; border:1px solid #EFE4D2; border-radius:10px; padding:12px; text-align:center;">
            <span style="font-size:0.75rem; color:var(--text-secondary); display:block; font-weight:700; text-transform:uppercase;">Art Class</span>
            <strong style="font-size:1.3rem; color:var(--vermilion);"><%= countArt %></strong>
          </div>
          <div style="background:#FDFBF7; border:1px solid #EFE4D2; border-radius:10px; padding:12px; text-align:center;">
            <span style="font-size:0.75rem; color:var(--text-secondary); display:block; font-weight:700; text-transform:uppercase;">Music Class</span>
            <strong style="font-size:1.3rem; color:var(--vermilion);"><%= countMusic %></strong>
          </div>
          <div style="background:#FDFBF7; border:1px solid #EFE4D2; border-radius:10px; padding:12px; text-align:center;">
            <span style="font-size:0.75rem; color:var(--text-secondary); display:block; font-weight:700; text-transform:uppercase;">Both Art &amp; Music</span>
            <strong style="font-size:1.3rem; color:var(--vermilion);"><%= countBoth %></strong>
          </div>
          <div style="background:#FDFBF7; border:1px solid #EFE4D2; border-radius:10px; padding:12px; text-align:center;">
            <span style="font-size:0.75rem; color:var(--text-secondary); display:block; font-weight:700; text-transform:uppercase;">Education</span>
            <strong style="font-size:1.3rem; color:var(--vermilion);"><%= countEdu %></strong>
          </div>
          <div style="background:#FDFBF7; border:1px solid #EFE4D2; border-radius:10px; padding:12px; text-align:center;">
            <span style="font-size:0.75rem; color:var(--text-secondary); display:block; font-weight:700; text-transform:uppercase;">Gita Gyaan</span>
            <strong style="font-size:1.3rem; color:var(--vermilion);"><%= countGita %></strong>
          </div>
          <div style="background:#FDFBF7; border:1px solid #EFE4D2; border-radius:10px; padding:12px; text-align:center;">
            <span style="font-size:0.75rem; color:var(--text-secondary); display:block; font-weight:700; text-transform:uppercase;">Cultural &amp; Other</span>
            <strong style="font-size:1.3rem; color:var(--vermilion);"><%= countCultural + countOther %></strong>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <span class="card-title">Applications Table</span>
        </div>

        <% if (apps.length === 0) { %>
          <div class="empty-state">
            <div class="empty-icon">🎒</div>
            <p>No admission applications received yet.</p>
          </div>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>#</th>
                  <th>Photo</th>
                  <th>Student Name</th>
                  <th>ID Proof</th>
                  <th>DOB / Gender</th>
                  <th>Class</th>
                  <th>Programme</th>
                  <th>Branch</th>
                  <th>Parent / Mobile</th>
                  <th>Address</th>
                  <th>Applied On</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% apps.forEach((app, idx) => { %>
                  <tr class="app-row <%= editApp && editApp.id === app.id ? 'editing-row' : '' %> <%= app.status === 'pending' ? 'row-pending' : '' %>" data-programme="<%= (app.programme || '').toLowerCase() %>" data-branch="<%= (app.branch || '').toLowerCase() %>" data-status="<%= (app.status || '').toLowerCase() %>">
                    <td style="color:var(--text-muted);font-size:0.8rem;"><%= idx + 1 %></td>
                    <td>
                      <% if (app.passport_photo) { %>
                        <a href="<%= app.passport_photo %>" target="_blank" title="Click to view full photo">
                          <img src="<%= app.passport_photo %>" alt="Passport Photo" style="width:40px;height:48px;object-fit:cover;border-radius:4px;border:1px solid var(--border);">
                        </a>
                      <% } else { %>
                        <span style="color:var(--text-muted);font-size:0.75rem;">No Photo</span>
                      <% } %>
                    </td>
                    <td>
                      <span style="display:inline-block;padding:2px 6px;background:rgba(178,58,47,0.1);color:var(--vermilion);font-weight:700;font-size:0.75rem;border-radius:4px;margin-bottom:4px;">
                        <%= app.arn || ('KFA-2026-' + String(app.id).padStart(4, '0')) %>
                      </span>
                      <div class="td-name"><%= app.student_name %></div>
                      <% if (app.email) { %>
                        <div style="font-size:0.76rem;color:var(--text-muted);">
                          <a href="mailto:<%= app.email %>" style="color:var(--info);"><%= app.email %></a>
                        </div>
                      <% } %>
                    </td>
                    <td style="font-size:0.8rem;">
                      <% if (app.id_proof) { %>
                        <a href="<%= app.id_proof %>" target="_blank" class="btn btn-ghost btn-sm" style="padding:4px 8px;font-size:0.75rem;" title="View Aadhaar / Birth Certificate">
                          🪪 View ID
                        </a>
                      <% } else { %>
                        <span style="color:var(--text-muted);font-size:0.75rem;">No Document</span>
                      <% } %>
                    </td>
                    <td style="font-size:0.82rem;">
                      <%= app.dob ? new Date(app.dob).toLocaleDateString('en-IN') : '—' %><br>
                      <span style="color:var(--text-muted);"><%= app.gender || '—' %></span>
                    </td>
                    <td style="font-size:0.85rem;font-weight:600;color:var(--text-primary);"><%= app.class_applying_for || '—' %></td>
                    <td>
                      <span class="badge" style="background:rgba(178,58,47,0.1); color:var(--vermilion); font-weight:700; padding:4px 8px; font-size:0.8rem;">
                        <%= app.programme || '—' %>
                      </span>
                    </td>
                    <td style="font-size:0.85rem;font-weight:600;">
                      <% if (app.branch === 'Coochbehar') { %>
                        <span class="badge" style="background:rgba(76,107,63,.12);color:var(--leaf);">Coochbehar</span>
                      <% } else if (app.branch === 'Kolkata') { %>
                        <span class="badge" style="background:rgba(217,169,78,.18);color:#8A6020;">Kolkata</span>
                      <% } else { %>
                        <span style="color:var(--text-muted);font-size:0.82rem;"><%= app.branch || '—' %></span>
                      <% } %>
                    </td>
                    <td style="font-size:0.82rem;">
                      <% if (app.father_name) { %><div>👨 <%= app.father_name %></div><% } %>
                      <% if (app.mother_name) { %><div>👩 <%= app.mother_name %></div><% } %>
                      <% if (app.occupation) { %><div style="font-size:0.75rem;color:var(--text-muted);">💼 <%= app.occupation %></div><% } %>
                      <% if (app.parent_mobile) { %><div><a href="tel:<%= app.parent_mobile %>" style="color:var(--info);font-weight:600;">📞 <%= app.parent_mobile %></a></div><% } %>
                      <% if (app.mother_mobile) { %><div><a href="tel:<%= app.mother_mobile %>" style="color:var(--info);font-weight:600;">📞 <%= app.mother_mobile %></a></div><% } %>
                      <% if (app.aadhaar_no) { %><div style="font-size:0.75rem;color:var(--text-muted);">🆔 <%= app.aadhaar_no %></div><% } %>
                    </td>
                    <td style="font-size:0.8rem;color:var(--text-muted);">
                      <%
                        let fullAddress = '';
                        if (app.village_locality || app.po || app.ps || app.district || app.pin_code) {
                          fullAddress = [
                            app.village_locality ? ('Vill/Loc: ' + app.village_locality) : null,
                            app.po ? ('P.O.: ' + app.po) : null,
                            app.ps ? ('P.S.: ' + app.ps) : null,
                            app.district ? ('Dist: ' + app.district) : null,
                            app.state ? app.state : null,
                            app.pin_code ? ('PIN: ' + app.pin_code) : null
                          ].filter(Boolean).join(', ');
                        } else if (app.address) {
                          fullAddress = app.address;
                        }
                      %>
                      <%= fullAddress || '—' %>
                    </td>
                    <td style="white-space:nowrap;font-size:0.8rem;">
                      <%= new Date(app.created_at).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %>
                    </td>
                    <td>
                      <span class="badge badge-<%= app.status %>"><%= app.status %></span>
                    </td>
                    <td>
                      <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;">
                        <a href="/admin/admissions/<%= app.id %>/edit" class="btn btn-ghost btn-sm" style="padding:4px 8px;font-size:0.75rem;font-weight:700;" title="Edit Application">
                          ✏️ Edit
                        </a>
                        <a href="/admin/admissions/pdf/<%= app.id %>" target="_blank" class="btn btn-ghost btn-sm" style="padding:4px 8px;font-size:0.75rem;font-weight:700;" title="Print/Download PDF Form">
                          📄 PDF
                        </a>
                        <form action="/admin/admissions/<%= app.id %>?_method=PUT" method="POST" style="display:flex;gap:4px;">
                          <select name="status" style="background:var(--bg-input);border:1px solid var(--border);border-radius:6px;color:var(--text-primary);font-size:0.78rem;padding:4px 8px;">
                            <option value="pending"  <%= app.status==='pending'  ? 'selected':'' %>>Pending</option>
                            <option value="approved" <%= app.status==='approved' ? 'selected':'' %>>Approved</option>
                            <option value="rejected" <%= app.status==='rejected' ? 'selected':'' %>>Rejected</option>
                          </select>
                          <button type="submit" class="btn btn-ghost btn-sm">Save</button>
                        </form>
                        <form action="/admin/admissions/<%= app.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this application permanently?')">
                          <button type="submit" class="btn btn-danger btn-sm btn-icon" title="Delete">🗑</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

    </div>
  </div>
<script>
function printReport(orientation) {
  let styleEl = document.getElementById('printOrientationStyle');
  if (!styleEl) {
    styleEl = document.createElement('style');
    styleEl.id = 'printOrientationStyle';
    document.head.appendChild(styleEl);
  }

  if (orientation === 'portrait') {
    document.body.classList.remove('print-mode-landscape');
    document.body.classList.add('print-mode-portrait');
    styleEl.textContent = '@media print { @page { size: A4 portrait; margin: 8mm 6mm; } }';
  } else {
    document.body.classList.remove('print-mode-portrait');
    document.body.classList.add('print-mode-landscape');
    styleEl.textContent = '@media print { @page { size: A4 landscape; margin: 8mm 10mm; } }';
  }

  setTimeout(function() {
    window.print();
  }, 100);
}

document.addEventListener('DOMContentLoaded', function() {
  const pills = document.querySelectorAll('#filterPillGroup .filter-pill');
  const tableRows = document.querySelectorAll('tbody tr.app-row');
  const showingCounter = document.getElementById('showingCount');

  pills.forEach(pill => {
    pill.addEventListener('click', function() {
      pills.forEach(p => p.classList.remove('active'));
      this.classList.add('active');

      const filterVal = this.getAttribute('data-filter');
      const filterLower = filterVal.toLowerCase();
      let visibleCount = 0;

      tableRows.forEach(row => {
        const prog = (row.getAttribute('data-programme') || '').toLowerCase();
        const rowText = (row.innerText || '').toLowerCase();

        let isMatch = false;
        if (filterVal === 'all') {
          isMatch = true;
        } else {
          isMatch = prog.includes(filterLower) || rowText.includes(filterLower);
        }

        if (isMatch) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      if (showingCounter) {
        if (filterVal === 'all') {
          showingCounter.innerHTML = 'Total Applications: <strong>' + visibleCount + '</strong>';
        } else {
          showingCounter.innerHTML = 'Showing <strong>' + visibleCount + '</strong> application(s) filtered by: <span style="color:var(--vermilion);font-weight:700;">' + filterVal + '</span>';
        }
      }
    });
  });
});
</script>
<script src="/js/admin.js"></script>
</body>
</html>
