<!DOCTYPE html>
<html lang="en" class="notranslate">
<head>
  <meta charset="UTF-8">
  <meta name="google" content="notranslate">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="apple-touch-icon" href="/images/icon-192.png">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#B23A2F">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="KF CMS">
  <meta name="robots" content="noindex, nofollow">
  <title>Gallery Manager — Kamalarani Foundation CMS</title>
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/pwa-register.js" defer></script>
  <style>
    /* ── Tab strip ─────────────────────────────── */
    .gallery-tabs { display:flex; gap:8px; margin-bottom:24px; }
    .gallery-tab  {
      flex:1; padding:12px 20px; border:2px solid var(--border);
      border-radius:10px; background:var(--bg-card); color:var(--text-secondary);
      font-size:0.92rem; font-weight:600; cursor:pointer;
      transition:all .2s; text-align:center;
    }
    .gallery-tab:hover  { border-color:var(--accent); color:var(--accent); }
    .gallery-tab.active { background:var(--accent); border-color:var(--accent); color:#fff; }

    /* ── Upload panels ──────────────────────────── */
    .upload-panel { display:none; }
    .upload-panel.active { display:block; }

    /* ── Upload zone ────────────────────────────── */
    .upload-zone {
      border:2px dashed var(--border); border-radius:12px;
      padding:40px 20px; text-align:center; cursor:pointer;
      transition:border-color .2s, background .2s; position:relative;
    }
    .upload-zone:hover, .upload-zone.dragover { border-color:var(--accent); background:rgba(var(--accent-rgb),.05); }
    .upload-zone input[type="file"] { position:absolute; inset:0; opacity:0; cursor:pointer; width:100%; height:100%; }
    .upload-zone-icon { font-size:2.4rem; margin-bottom:8px; }
    .upload-zone h3   { margin:0 0 4px; font-size:1rem; color:var(--text-primary); }
    .upload-zone p    { margin:0; font-size:0.83rem; color:var(--text-muted); }

    /* ── Preview grid ────────────────────────────── */
    .preview-grid  { display:flex; flex-wrap:wrap; gap:10px; margin-top:16px; }
    .preview-item  {
      width:90px; height:70px; border-radius:8px; overflow:hidden;
      background:var(--bg-input); position:relative;
    }
    .preview-item img,
    .preview-item video { width:100%; height:100%; object-fit:cover; }
    .preview-remove {
      position:absolute; top:3px; right:3px;
      width:20px; height:20px; border-radius:50%;
      background:rgba(0,0,0,.65); color:#fff;
      border:none; cursor:pointer; font-size:13px; line-height:20px;
      display:flex; align-items:center; justify-content:center;
      transition:background .15s;
      z-index:2;
    }
    .preview-remove:hover { background:rgba(220,40,40,.85); }

    /* ── Gallery admin grids ─────────────────────── */
    .gallery-admin-grid {
      display:grid;
      grid-template-columns:repeat(auto-fill, minmax(200px, 1fr));
      gap:16px;
    }
    .gallery-admin-card {
      border:1px solid var(--border); border-radius:10px; overflow:hidden;
      background:var(--bg-card); display:flex; flex-direction:column;
      position:relative; box-shadow:0 2px 8px rgba(0,0,0,0.04);
    }
    .gallery-admin-thumb {
      width:100%; aspect-ratio:4/3; background:var(--bg-input); overflow:hidden; position:relative;
      display:block; padding:0; border:0; cursor:pointer;
    }
    .gallery-admin-thumb img,
    .gallery-admin-thumb video { width:100%; height:100%; object-fit:cover; display:block; transition:transform .25s ease; }
    .gallery-admin-thumb:hover img,
    .gallery-admin-thumb:hover video { transform:scale(1.04); }
    .gallery-viewer {
      width:min(900px, calc(100vw - 32px)); max-height:calc(100vh - 32px);
      padding:0; overflow:hidden; border:0; border-radius:14px;
      background:#111; box-shadow:0 24px 80px rgba(0,0,0,.45);
    }
    .gallery-viewer::backdrop { background:rgba(0,0,0,.72); backdrop-filter:blur(2px); }
    .gallery-viewer-content {
      min-height:220px; display:flex; align-items:center; justify-content:center;
    }
    .gallery-viewer-content img,
    .gallery-viewer-content video {
      display:block; max-width:100%; max-height:calc(100vh - 80px); object-fit:contain;
    }
    .gallery-viewer-close {
      position:absolute; top:10px; right:10px; z-index:2;
      width:36px; height:36px; border:0; border-radius:50%;
      color:#fff; background:rgba(178,58,47,.92); font-size:1.1rem;
      box-shadow:0 3px 12px rgba(0,0,0,.3); cursor:pointer;
    }
    .gallery-admin-info {
      padding:10px 12px; display:flex; flex-direction:column; gap:4px;
      border-top:1px solid var(--border); background:#fff;
    }
    .item-type-badge { position:absolute; top:6px; left:6px; z-index:2; }

    /* ── Section headings inside card ───────────── */
    .media-section-title {
      font-size:0.78rem; font-weight:700; letter-spacing:.06em;
      text-transform:uppercase; color:var(--text-muted); margin-bottom:14px;
    }
    .badge-image { background:rgba(64,190,120,.18); color:#3db87a; }
    .badge-video { background:rgba(120,80,220,.18); color:#8a5cf6; }
  </style>
</head>
<body>
<div class="admin-layout">
  <%- include('partials/sidebar') %>

  <div class="admin-main">
    <% var images = locals.images || []; var videos = locals.videos || []; %>
    <div class="admin-topbar">
      <div style="display:flex;align-items:center;gap:14px;">
        <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">☰</button>
        <span class="topbar-title">Gallery Manager</span>
      </div>
      <div class="topbar-right">
        <a href="/gallery" class="topbar-site-link" target="_blank">↗ View Public Gallery</a>
      </div>
    </div>

    <div class="admin-content">
      <% if (locals.success && locals.success.length) { %>
        <div class="flash-bar success">✅ <%= locals.success[0] %></div>
      <% } %>
      <% if (locals.error && locals.error.length) { %>
        <div class="flash-bar error">⚠️ <%= locals.error[0] %></div>
      <% } %>

      <div class="page-header">
        <div class="page-header-left">
          <h1>Gallery</h1>
          <p>Upload photos and videos from classes and events. They appear on the public gallery page.</p>
        </div>
      </div>

      <!-- ── Tab strip ───────────────────────────────── -->
      <div class="gallery-tabs" role="tablist">
        <button class="gallery-tab active" id="tabImgBtn" role="tab" aria-selected="true"  aria-controls="panelImages" onclick="switchTab('images')">📷 Image Upload</button>
        <button class="gallery-tab"        id="tabVidBtn" role="tab" aria-selected="false" aria-controls="panelVideos" onclick="switchTab('videos')">🎬 Video Upload</button>
      </div>

      <!-- ── IMAGE Upload Panel ─────────────────────── -->
      <div class="upload-panel active card" id="panelImages" style="margin-bottom:28px;" role="tabpanel" aria-labelledby="tabImgBtn">
        <div class="card-header">
          <span class="card-title">📷 Upload Images</span>
          <span style="font-size:0.8rem;color:var(--text-muted)">Max 15 files · auto-compressed to 5 MB · PNG, JPG, JPEG, WEBP</span>
        </div>
        <div class="card-body">
          <form action="/admin/gallery/images" method="POST" enctype="multipart/form-data" id="imageForm">
            <div class="upload-zone" id="imageDropZone">
              <div class="upload-zone-icon">🖼️</div>
              <h3>Drag &amp; drop images here</h3>
              <p>or click to browse — PNG, JPG, JPEG only</p>
              <input type="file" name="images" id="imageInput" multiple accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp">
            </div>
            <div class="preview-grid" id="imagePreviewGrid"></div>
            <div id="imageErrorBanner" style="display:none;margin-top:10px;padding:10px 14px;background:#fef2f2;border:1.5px solid #fca5a5;border-radius:8px;color:#b91c1c;font-size:0.85rem;font-weight:600;"></div>
            <div style="margin-top:20px;display:flex;justify-content:flex-end;">
              <button type="submit" class="btn btn-primary" id="uploadImgBtn" style="padding:10px 24px; font-size:0.95rem;">📤 Upload Images</button>
            </div>
          </form>
        </div>
      </div>

      <!-- ── VIDEO Upload Panel ─────────────────────── -->
      <div class="upload-panel card" id="panelVideos" style="margin-bottom:28px;" role="tabpanel" aria-labelledby="tabVidBtn">
        <div class="card-header">
          <span class="card-title">🎬 Upload Videos</span>
          <span style="font-size:0.8rem;color:var(--text-muted)">Max 5 files · MP4 only · Up to 500 MB per file</span>
        </div>
        <div class="card-body">
          <form action="/admin/gallery/videos" method="POST" enctype="multipart/form-data" id="videoForm">
            <div class="upload-zone" id="videoDropZone">
              <div class="upload-zone-icon">🎬</div>
              <h3>Drag &amp; drop videos here</h3>
              <p>or click to browse — MP4 format only</p>
              <input type="file" name="videos" id="videoInput" multiple accept=".mp4,video/mp4">
            </div>
            <div class="preview-grid" id="videoPreviewGrid"></div>
            <div id="videoErrorBanner" style="display:none;margin-top:10px;padding:10px 14px;background:#fef2f2;border:1.5px solid #fca5a5;border-radius:8px;color:#b91c1c;font-size:0.85rem;font-weight:600;"></div>
            <div style="margin-top:20px;display:flex;justify-content:flex-end;">
              <button type="submit" class="btn btn-primary" id="uploadVidBtn" style="padding:10px 24px; font-size:0.95rem;">📤 Upload Videos</button>
            </div>
          </form>
        </div>
      </div>

      <!-- ── Uploaded Images Grid ───────────────────── -->
      <div class="card" style="margin-bottom:24px;">
        <div class="card-header">
          <span class="card-title">🖼️ Uploaded Images (<%= images.length %>)</span>
        </div>
        <div class="card-body">
          <% if (images.length === 0) { %>
            <div class="empty-state">
              <div class="empty-icon">🖼️</div>
              <p>No images uploaded yet. Use the Image panel above to add photos!</p>
            </div>
          <% } else { %>
            <div class="gallery-admin-grid">
              <% images.forEach(item => { %>
                <% 
                  const pPurpose = item.purpose || item.caption || 'Free Art Class';
                  const pDate = item.event_date ? new Date(item.event_date).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) : '15 Jul 2026';
                  const pPlace = item.place || 'Natabari';
                %>
                <div class="gallery-admin-card">
                  <button type="button" class="gallery-admin-thumb gallery-media-open" data-media-type="image" data-media-url="<%= item.media_url %>" data-media-title="<%= pPurpose %>" title="Open full image">
                    <img src="<%= item.media_url %>" alt="<%= pPurpose %>" loading="lazy">
                    <div class="item-type-badge"><span class="badge badge-image">image</span></div>
                  </button>
                  <div class="gallery-admin-info">
                    <div style="font-weight:700; font-size:0.83rem; color:var(--text-primary); line-height:1.2;"><%= pPurpose %></div>
                    <div style="font-size:0.75rem; color:var(--text-secondary); display:flex; gap:8px; flex-wrap:wrap; margin-bottom:4px;">
                      <span>📍 <%= pPlace %></span>
                      <span>📅 <%= pDate %></span>
                    </div>
                    <form action="/admin/gallery/<%= item.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this image permanently?')">
                      <button type="submit" class="btn btn-danger btn-sm" style="width:100%; font-size:0.75rem; padding:4px 8px;">🗑 Delete</button>
                    </form>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>

      <!-- ── Uploaded Videos Grid ───────────────────── -->
      <div class="card">
        <div class="card-header">
          <span class="card-title">🎬 Uploaded Videos (<%= videos.length %>)</span>
        </div>
        <div class="card-body">
          <% if (videos.length === 0) { %>
            <div class="empty-state">
              <div class="empty-icon">🎬</div>
              <p>No videos uploaded yet. Use the Video panel above to add MP4 videos!</p>
            </div>
          <% } else { %>
            <div class="gallery-admin-grid">
              <% videos.forEach(item => { %>
                <% 
                  const vPurpose = item.purpose || item.caption || 'Free Class Video';
                  const vDate = item.event_date ? new Date(item.event_date).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) : '15 Jul 2026';
                  const vPlace = item.place || 'Natabari';
                %>
                <div class="gallery-admin-card">
                  <button type="button" class="gallery-admin-thumb gallery-media-open" data-media-type="video" data-media-url="<%= item.media_url %>" data-media-title="<%= vPurpose %>" title="Open and play video">
                    <video src="<%= item.media_url %>" muted preload="metadata"></video>
                    <div class="item-type-badge"><span class="badge badge-video">video</span></div>
                  </button>
                  <div class="gallery-admin-info">
                    <div style="font-weight:700; font-size:0.83rem; color:var(--text-primary); line-height:1.2;"><%= vPurpose %></div>
                    <div style="font-size:0.75rem; color:var(--text-secondary); display:flex; gap:8px; flex-wrap:wrap; margin-bottom:4px;">
                      <span>📍 <%= vPlace %></span>
                      <span>📅 <%= vDate %></span>
                    </div>
                    <form action="/admin/gallery/<%= item.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this video permanently?')">
                      <button type="submit" class="btn btn-danger btn-sm" style="width:100%; font-size:0.75rem; padding:4px 8px;">🗑 Delete</button>
                    </form>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>
</div>

<dialog class="gallery-viewer" id="galleryViewer" aria-label="Gallery media viewer">
  <button type="button" class="gallery-viewer-close" id="galleryViewerClose" aria-label="Close media viewer">✕</button>
  <div class="gallery-viewer-content" id="galleryViewerContent"></div>
</dialog>

<script src="/js/admin.js"></script>
<script>
  // ── Tab switcher ────────────────────────────────────────────────────────────
  function switchTab(tab) {
    const isImages = tab === 'images';
    document.getElementById('tabImgBtn').classList.toggle('active', isImages);
    document.getElementById('tabVidBtn').classList.toggle('active', !isImages);
    document.getElementById('panelImages').classList.toggle('active', isImages);
    document.getElementById('panelVideos').classList.toggle('active', !isImages);
    document.getElementById('tabImgBtn').setAttribute('aria-selected', isImages ? 'true' : 'false');
    document.getElementById('tabVidBtn').setAttribute('aria-selected', isImages ? 'false' : 'true');
  }

  // ── Drag-and-drop + preview helper (with per-item remove) ───────────────────

  // Holds the current File arrays (since FileList is read-only)
  const fileStore = { images: [], videos: [] };

  function syncInputFiles(input, files) {
    const dt = new DataTransfer();
    files.forEach(f => dt.items.add(f));
    input.files = dt.files;
  }

  function showError(storeKey, msg) {
    const errorBannerId = storeKey === 'images' ? 'imageErrorBanner' : 'videoErrorBanner';
    const uploadBtnId   = storeKey === 'images' ? 'uploadImgBtn' : 'uploadVidBtn';
    const banner = document.getElementById(errorBannerId);
    const uploadBtn = document.getElementById(uploadBtnId);
    if (banner) {
      banner.textContent = '⚠️ ' + msg;
      banner.style.display = 'block';
    }
    if (uploadBtn) uploadBtn.disabled = true;
  }

  function clearError(storeKey) {
    const errorBannerId = storeKey === 'images' ? 'imageErrorBanner' : 'videoErrorBanner';
    const uploadBtnId   = storeKey === 'images' ? 'uploadImgBtn' : 'uploadVidBtn';
    const banner = document.getElementById(errorBannerId);
    const uploadBtn = document.getElementById(uploadBtnId);
    if (banner) {
      banner.style.display = 'none';
      banner.textContent = '';
    }
    if (uploadBtn) uploadBtn.disabled = false;
  }

  function saveCurrentInputValues(storeKey) {
    const gridId = storeKey === 'images' ? 'imagePreviewGrid' : 'videoPreviewGrid';
    const grid = document.getElementById(gridId);
    if (!grid) return [];
    const cards = grid.querySelectorAll('.preview-item-card');
    const values = [];
    cards.forEach(card => {
      const p = card.querySelector('.' + storeKey + '-purpose-input');
      const d = card.querySelector('.' + storeKey + '-date-input');
      const pl = card.querySelector('.' + storeKey + '-place-input');
      values.push({
        purpose: p ? p.value : '',
        date: d ? d.value : '',
        place: pl ? pl.value : ''
      });
    });
    return values;
  }

  function renderPreviews(files, grid, isVideo, storeKey, input, maxCount, savedValues) {
    grid.innerHTML = '';
    if (!files || files.length === 0) return;

    const values = savedValues || [];

    // Batch fill header container
    const batchBar = document.createElement('div');
    batchBar.style.cssText = 'width:100%; background:rgba(178,58,47,0.06); border:1px solid rgba(178,58,47,0.2); border-radius:8px; padding:10px 14px; margin-bottom:12px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;';
    batchBar.innerHTML = `
      <span style="font-size:0.82rem; font-weight:700; color:var(--vermilion);">⚡ Quick Batch-Fill Details for All ${files.length} File(s):</span>
      <input type="text" id="${storeKey}_batchPurpose" placeholder="Purpose e.g. Free Art Supplies Distribution" style="padding:6px 10px; font-size:0.8rem; border-radius:6px; border:1px solid #ccc; flex:1; min-width:180px;">
      <input type="date" id="${storeKey}_batchDate" value="2026-07-15" style="padding:6px 10px; font-size:0.8rem; border-radius:6px; border:1px solid #ccc;">
      <select id="${storeKey}_batchPlace" style="padding:6px 10px; font-size:0.8rem; border-radius:6px; border:1px solid #ccc; background:#fff;">
        <option value="Natabari">Natabari</option>
        <option value="Kolkata">Kolkata</option>
        <option value="Coochbehar">Coochbehar</option>
        <option value="West Bengal">West Bengal</option>
      </select>
      <button type="button" class="btn btn-outline btn-sm" style="font-size:0.78rem; padding:6px 12px;" onclick="applyBatchFill('${storeKey}')">Apply To All</button>
    `;
    grid.appendChild(batchBar);

    const limited = files.slice(0, maxCount);
    limited.forEach((file, idx) => {
      const card = document.createElement('div');
      card.className = 'preview-item-card';
      card.style.cssText = 'width:100%; display:flex; gap:14px; background:#FDFBF7; border:1px solid #EFE4D2; border-radius:10px; padding:12px; margin-bottom:8px; align-items:center; flex-wrap:wrap; position:relative;';

      const url = URL.createObjectURL(file);
      const val = values[idx] || {};

      // Thumbnail container
      const thumbBox = document.createElement('div');
      thumbBox.style.cssText = 'width:90px; height:70px; border-radius:8px; overflow:hidden; background:#eee; position:relative; flex-shrink:0;';

      const media = document.createElement(isVideo ? 'video' : 'img');
      media.src = url;
      media.style.cssText = 'width:100%; height:100%; object-fit:cover; display:block;';
      if (isVideo) media.muted = true;
      thumbBox.appendChild(media);

      // Remove button
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'preview-remove';
      btn.title = 'Remove this file';
      btn.innerHTML = '&times;';
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const currentVals = saveCurrentInputValues(storeKey);
        currentVals.splice(idx, 1);
        fileStore[storeKey].splice(idx, 1);
        syncInputFiles(input, fileStore[storeKey]);
        if (fileStore[storeKey].length <= maxCount) clearError(storeKey);
        renderPreviews(fileStore[storeKey], grid, isVideo, storeKey, input, maxCount, currentVals);
      });
      thumbBox.appendChild(btn);
      card.appendChild(thumbBox);

      // Input fields container
      const fieldsBox = document.createElement('div');
      fieldsBox.style.cssText = 'flex:1; min-width:280px; display:grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap:10px;';

      const purposeVal = val.purpose ? val.purpose.replace(/"/g, '&quot;') : '';
      const dateVal = val.date || '';
      const placeVal = val.place || '';

      fieldsBox.innerHTML = `
        <div>
          <label style="font-size:0.75rem; font-weight:700; color:var(--text-secondary); display:block; margin-bottom:4px;">📌 Purpose / Title <span style="color:red">*</span></label>
          <input type="text" name="purposes[]" class="${storeKey}-purpose-input" required placeholder="Enter Purpose / Program Name *" value="${purposeVal}" style="width:100%; padding:6px 10px; border:1px solid var(--border); border-radius:6px; font-size:0.83rem;">
        </div>
        <div>
          <label style="font-size:0.75rem; font-weight:700; color:var(--text-secondary); display:block; margin-bottom:4px;">📅 Event Date <span style="color:red">*</span></label>
          <input type="date" name="event_dates[]" class="${storeKey}-date-input" required value="${dateVal}" style="width:100%; padding:6px 10px; border:1px solid var(--border); border-radius:6px; font-size:0.83rem;">
        </div>
        <div>
          <label style="font-size:0.75rem; font-weight:700; color:var(--text-secondary); display:block; margin-bottom:4px;">📍 Place / Location <span style="color:red">*</span></label>
          <select name="places[]" class="${storeKey}-place-input" required style="width:100%; padding:6px 10px; border:1px solid var(--border); border-radius:6px; font-size:0.83rem; background:#fff;">
            <option value="" disabled ${!placeVal ? 'selected' : ''}>-- Select Location * --</option>
            <option value="Natabari" ${placeVal === 'Natabari' ? 'selected' : ''}>Natabari</option>
            <option value="Kolkata" ${placeVal === 'Kolkata' ? 'selected' : ''}>Kolkata</option>
            <option value="Coochbehar" ${placeVal === 'Coochbehar' ? 'selected' : ''}>Coochbehar</option>
            <option value="West Bengal" ${placeVal === 'West Bengal' ? 'selected' : ''}>Other Location (West Bengal)</option>
          </select>
        </div>
      `;
      card.appendChild(fieldsBox);
      grid.appendChild(card);
    });
  }

  function applyBatchFill(storeKey) {
    const pVal = (document.getElementById(storeKey + '_batchPurpose').value || '').trim();
    const dVal = (document.getElementById(storeKey + '_batchDate').value || '').trim();
    const plVal = (document.getElementById(storeKey + '_batchPlace').value || '').trim();

    if (pVal) {
      document.querySelectorAll('.' + storeKey + '-purpose-input').forEach(inp => {
        inp.value = pVal;
        inp.style.border = '1px solid var(--border)';
      });
    }
    if (dVal) {
      document.querySelectorAll('.' + storeKey + '-date-input').forEach(inp => {
        inp.value = dVal;
        inp.style.border = '1px solid var(--border)';
      });
    }
    if (plVal) {
      document.querySelectorAll('.' + storeKey + '-place-input').forEach(inp => {
        inp.value = plVal;
        inp.style.border = '1px solid var(--border)';
      });
    }
  }

  function initDropZone(dropZoneId, inputId, previewGridId, isVideo, storeKey, maxCount) {
    const dropZone    = document.getElementById(dropZoneId);
    const input       = document.getElementById(inputId);
    const previewGrid = document.getElementById(previewGridId);

    input.addEventListener('click', e => e.stopPropagation());
    dropZone.addEventListener('click', () => input.click());

    const handleFiles = (incomingFiles) => {
      const incoming = Array.from(incomingFiles);
      const currentVals = saveCurrentInputValues(storeKey);
      const merged   = [...fileStore[storeKey], ...incoming];

      if (merged.length > maxCount) {
        showError(storeKey, `You can only upload up to ${maxCount} files at a time. Currently selected: ${merged.length}. Please remove some before uploading.`);
        return;
      }

      clearError(storeKey);
      fileStore[storeKey] = merged;
      syncInputFiles(input, merged);
      renderPreviews(merged, previewGrid, isVideo, storeKey, input, maxCount, currentVals);
    };

    dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('dragover'); });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
    dropZone.addEventListener('drop', e => {
      e.preventDefault();
      dropZone.classList.remove('dragover');
      if (e.dataTransfer && e.dataTransfer.files.length) handleFiles(e.dataTransfer.files);
    });
    input.addEventListener('change', () => {
      if (input.files && input.files.length) handleFiles(input.files);
    });
  }

  initDropZone('imageDropZone', 'imageInput', 'imagePreviewGrid', false, 'images', 15);
  initDropZone('videoDropZone', 'videoInput', 'videoPreviewGrid', true,  'videos', 5);

  // ── Final submit mandatory field validation guard ──
  ['imageForm', 'videoForm'].forEach(formId => {
    const formEl = document.getElementById(formId);
    if (!formEl) return;
    formEl.addEventListener('submit', function(e) {
      const storeKey = formId === 'imageForm' ? 'images' : 'videos';
      const purposes = formEl.querySelectorAll('.' + storeKey + '-purpose-input');
      const dates = formEl.querySelectorAll('.' + storeKey + '-date-input');
      const places = formEl.querySelectorAll('.' + storeKey + '-place-input');

      if (fileStore[storeKey].length === 0) {
        e.preventDefault();
        alert('⚠️ Please select at least one file to upload.');
        return;
      }

      let hasMissing = false;
      let firstMissingInp = null;

      for (let i = 0; i < purposes.length; i++) {
        const pInp = purposes[i];
        const dInp = dates[i];
        const plInp = places[i];

        [pInp, dInp, plInp].forEach(inp => {
          if (inp && (!inp.value || !inp.value.trim())) {
            inp.style.border = '2px solid #ef4444';
            hasMissing = true;
            if (!firstMissingInp) firstMissingInp = inp;
          } else if (inp) {
            inp.style.border = '1px solid var(--border)';
          }
        });
      }

      if (hasMissing) {
        e.preventDefault();
        alert('⚠️ Mandatory fields missing! Please fill Purpose, Event Date, and Location for EVERY selected file before uploading.');
        if (firstMissingInp) firstMissingInp.focus();
      }
    });
  });

  // ── Full-size media viewer ──────────────────────────────────────────────────
  const galleryViewer = document.getElementById('galleryViewer');
  const galleryViewerContent = document.getElementById('galleryViewerContent');
  const galleryViewerClose = document.getElementById('galleryViewerClose');

  function closeGalleryViewer() {
    const video = galleryViewerContent.querySelector('video');
    if (video) video.pause();
    galleryViewer.close();
    galleryViewerContent.replaceChildren();
  }

  document.querySelectorAll('.gallery-media-open').forEach(button => {
    button.addEventListener('click', () => {
      const isVideo = button.dataset.mediaType === 'video';
      const media = document.createElement(isVideo ? 'video' : 'img');
      media.src = button.dataset.mediaUrl;
      if (isVideo) {
        media.controls = true;
        media.autoplay = true;
      } else {
        media.alt = button.dataset.mediaTitle || 'Gallery image';
      }
      galleryViewerContent.replaceChildren(media);
      galleryViewer.showModal();
    });
  });

  galleryViewerClose.addEventListener('click', closeGalleryViewer);
  galleryViewer.addEventListener('click', event => {
    if (event.target === galleryViewer) closeGalleryViewer();
  });
  galleryViewer.addEventListener('close', () => {
    const video = galleryViewerContent.querySelector('video');
    if (video) video.pause();
    galleryViewerContent.replaceChildren();
  });
</script>
</body>
</html>
