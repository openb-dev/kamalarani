<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="apple-touch-icon" href="/images/icon-192.png">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#B23A2F">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="KF CMS">
  <meta name="robots" content="noindex, nofollow">
  <title>Gallery Manager — Kamalarani Foundation CMS</title>
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/pwa-register.js" defer></script>
  <style>
    /* ── Tab strip ─────────────────────────────── */
    .gallery-tabs { display:flex; gap:8px; margin-bottom:24px; }
    .gallery-tab  {
      flex:1; padding:12px 20px; border:2px solid var(--border);
      border-radius:10px; background:var(--bg-card); color:var(--text-secondary);
      font-size:0.92rem; font-weight:600; cursor:pointer;
      transition:all .2s; text-align:center;
    }
    .gallery-tab:hover  { border-color:var(--accent); color:var(--accent); }
    .gallery-tab.active { background:var(--accent); border-color:var(--accent); color:#fff; }

    /* ── Upload panels ──────────────────────────── */
    .upload-panel { display:none; }
    .upload-panel.active { display:block; }

    /* ── Upload zone ────────────────────────────── */
    .upload-zone {
      border:2px dashed var(--border); border-radius:12px;
      padding:40px 20px; text-align:center; cursor:pointer;
      transition:border-color .2s, background .2s; position:relative;
    }
    .upload-zone:hover, .upload-zone.dragover { border-color:var(--accent); background:rgba(var(--accent-rgb),.05); }
    .upload-zone input[type="file"] { position:absolute; inset:0; opacity:0; cursor:pointer; width:100%; height:100%; }
    .upload-zone-icon { font-size:2.4rem; margin-bottom:8px; }
    .upload-zone h3   { margin:0 0 4px; font-size:1rem; color:var(--text-primary); }
    .upload-zone p    { margin:0; font-size:0.83rem; color:var(--text-muted); }

    /* ── Preview grid ────────────────────────────── */
    .preview-grid  { display:flex; flex-wrap:wrap; gap:10px; margin-top:16px; }
    .preview-item  {
      width:90px; height:70px; border-radius:8px; overflow:hidden;
      background:var(--bg-input); position:relative;
    }
    .preview-item img,
    .preview-item video { width:100%; height:100%; object-fit:cover; }
    .preview-remove {
      position:absolute; top:3px; right:3px;
      width:20px; height:20px; border-radius:50%;
      background:rgba(0,0,0,.65); color:#fff;
      border:none; cursor:pointer; font-size:13px; line-height:20px;
      display:flex; align-items:center; justify-content:center;
      transition:background .15s;
      z-index:2;
    }
    .preview-remove:hover { background:rgba(220,40,40,.85); }

    /* ── Gallery admin grids ─────────────────────── */
    .gallery-admin-grid {
      display:grid;
      grid-template-columns:repeat(auto-fill, minmax(160px, 1fr));
      gap:14px;
    }
    .gallery-admin-item {
      position:relative; border-radius:10px; overflow:hidden;
      aspect-ratio:4/3; background:var(--bg-input);
    }
    .gallery-admin-item img,
    .gallery-admin-item video { width:100%; height:100%; object-fit:cover; }
    .item-overlay {
      position:absolute; inset:0; background:rgba(0,0,0,.55);
      opacity:0; transition:opacity .2s;
      display:flex; flex-direction:column; justify-content:flex-end; padding:10px;
    }
    .gallery-admin-item:hover .item-overlay { opacity:1; }
    .item-caption { color:#fff; font-size:0.75rem; margin-bottom:6px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .item-actions { display:flex; gap:6px; }
    .item-type-badge { position:absolute; top:6px; left:6px; }

    /* ── Section headings inside card ───────────── */
    .media-section-title {
      font-size:0.78rem; font-weight:700; letter-spacing:.06em;
      text-transform:uppercase; color:var(--text-muted); margin-bottom:14px;
    }
    .badge-image { background:rgba(64,190,120,.18); color:#3db87a; }
    .badge-video { background:rgba(120,80,220,.18); color:#8a5cf6; }
  </style>
</head>
<body>
<div class="admin-layout">
  <%- include('partials/sidebar') %>

  <div class="admin-main">
    <% var images = locals.images || []; var videos = locals.videos || []; %>
    <div class="admin-topbar">
      <div style="display:flex;align-items:center;gap:14px;">
        <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">☰</button>
        <span class="topbar-title">Gallery Manager</span>
      </div>
      <div class="topbar-right">
        <a href="/gallery" class="topbar-site-link" target="_blank">↗ View Public Gallery</a>
      </div>
    </div>

    <div class="admin-content">
      <% if (locals.success && locals.success.length) { %>
        <div class="flash-bar success">✅ <%= locals.success[0] %></div>
      <% } %>
      <% if (locals.error && locals.error.length) { %>
        <div class="flash-bar error">⚠️ <%= locals.error[0] %></div>
      <% } %>

      <div class="page-header">
        <div class="page-header-left">
          <h1>Gallery</h1>
          <p>Upload photos and videos from classes and events. They appear on the public gallery page.</p>
        </div>
      </div>

      <!-- ── Tab strip ───────────────────────────────── -->
      <div class="gallery-tabs" role="tablist">
        <button class="gallery-tab active" id="tabImgBtn" role="tab" aria-selected="true"  aria-controls="panelImages" onclick="switchTab('images')">📷 Image Upload</button>
        <button class="gallery-tab"        id="tabVidBtn" role="tab" aria-selected="false" aria-controls="panelVideos" onclick="switchTab('videos')">🎬 Video Upload</button>
      </div>

      <!-- ── IMAGE Upload Panel ─────────────────────── -->
      <div class="upload-panel active card" id="panelImages" style="margin-bottom:28px;" role="tabpanel" aria-labelledby="tabImgBtn">
        <div class="card-header">
          <span class="card-title">📷 Upload Images</span>
          <span style="font-size:0.8rem;color:var(--text-muted)">Max 15 files · auto-compressed to 5 MB · PNG, JPG, JPEG, WEBP</span>
        </div>
        <div class="card-body">
          <form action="/admin/gallery/images" method="POST" enctype="multipart/form-data" id="imageForm">
            <div class="upload-zone" id="imageDropZone">
              <div class="upload-zone-icon">🖼️</div>
              <h3>Drag &amp; drop images here</h3>
              <p>or click to browse — PNG, JPG, JPEG only</p>
              <input type="file" name="images" id="imageInput" multiple accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp">
            </div>
            <div class="preview-grid" id="imagePreviewGrid"></div>
            <div id="imageErrorBanner" style="display:none;margin-top:10px;padding:10px 14px;background:#fef2f2;border:1.5px solid #fca5a5;border-radius:8px;color:#b91c1c;font-size:0.85rem;font-weight:600;"></div>
            <div style="margin-top:20px;display:flex;gap:16px;align-items:flex-end;flex-wrap:wrap;">
              <div class="field" style="flex:1;min-width:240px;">
                <label for="imageCaptionField">Caption (applies to all uploaded images)</label>
                <input type="text" id="imageCaptionField" name="caption" placeholder="e.g. Art class at Natabari, July 2026">
              </div>
              <button type="submit" class="btn btn-primary" id="uploadImgBtn">📤 Upload Images</button>
            </div>
          </form>
        </div>
      </div>

      <!-- ── VIDEO Upload Panel ─────────────────────── -->
      <div class="upload-panel card" id="panelVideos" style="margin-bottom:28px;" role="tabpanel" aria-labelledby="tabVidBtn">
        <div class="card-header">
          <span class="card-title">🎬 Upload Videos</span>
          <span style="font-size:0.8rem;color:var(--text-muted)">Max 5 files · MP4 only · Up to 500 MB per file</span>
        </div>
        <div class="card-body">
          <form action="/admin/gallery/videos" method="POST" enctype="multipart/form-data" id="videoForm">
            <div class="upload-zone" id="videoDropZone">
              <div class="upload-zone-icon">🎬</div>
              <h3>Drag &amp; drop videos here</h3>
              <p>or click to browse — MP4 format only</p>
              <input type="file" name="videos" id="videoInput" multiple accept=".mp4,video/mp4">
            </div>
            <div class="preview-grid" id="videoPreviewGrid"></div>
            <div style="margin-top:20px;display:flex;gap:16px;align-items:flex-end;flex-wrap:wrap;">
              <div class="field" style="flex:1;min-width:240px;">
                <label for="videoCaptionField">Caption (applies to all uploaded videos)</label>
                <input type="text" id="videoCaptionField" name="caption" placeholder="e.g. Drawing competition, July 2026">
              </div>
              <button type="submit" class="btn btn-primary" id="uploadVidBtn">📤 Upload Videos</button>
            </div>
          </form>
        </div>
      </div>

      <!-- ── Uploaded Images Grid ───────────────────── -->
      <div class="card" style="margin-bottom:24px;">
        <div class="card-header">
          <span class="card-title">🖼️ Uploaded Images (<%= images.length %>)</span>
        </div>
        <div class="card-body">
          <% if (images.length === 0) { %>
            <div class="empty-state">
              <div class="empty-icon">🖼️</div>
              <p>No images uploaded yet. Use the Image panel above to add photos!</p>
            </div>
          <% } else { %>
            <div class="gallery-admin-grid">
              <% images.forEach(item => { %>
                <div class="gallery-admin-item">
                  <img src="<%= item.media_url %>" alt="<%= item.caption || 'Gallery image' %>" loading="lazy">
                  <div class="item-type-badge"><span class="badge badge-image">image</span></div>
                  <div class="item-overlay">
                    <div class="item-caption"><%= item.caption || 'No caption' %></div>
                    <div class="item-actions">
                      <form action="/admin/gallery/<%= item.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this image from gallery and disk?')">
                        <button type="submit" class="btn btn-danger btn-sm btn-icon" title="Delete">🗑</button>
                      </form>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>

      <!-- ── Uploaded Videos Grid ───────────────────── -->
      <div class="card">
        <div class="card-header">
          <span class="card-title">🎬 Uploaded Videos (<%= videos.length %>)</span>
        </div>
        <div class="card-body">
          <% if (videos.length === 0) { %>
            <div class="empty-state">
              <div class="empty-icon">🎬</div>
              <p>No videos uploaded yet. Use the Video panel above to add MP4 videos!</p>
            </div>
          <% } else { %>
            <div class="gallery-admin-grid">
              <% videos.forEach(item => { %>
                <div class="gallery-admin-item">
                  <video src="<%= item.media_url %>" muted preload="metadata"></video>
                  <div class="item-type-badge"><span class="badge badge-video">video</span></div>
                  <div class="item-overlay">
                    <div class="item-caption"><%= item.caption || 'No caption' %></div>
                    <div class="item-actions">
                      <form action="/admin/gallery/<%= item.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this video from gallery and disk?')">
                        <button type="submit" class="btn btn-danger btn-sm btn-icon" title="Delete">🗑</button>
                      </form>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>
</div>

<script src="/js/admin.js"></script>
<script>
  // ── Tab switcher ────────────────────────────────────────────────────────────
  function switchTab(tab) {
    const isImages = tab === 'images';
    document.getElementById('tabImgBtn').classList.toggle('active', isImages);
    document.getElementById('tabVidBtn').classList.toggle('active', !isImages);
    document.getElementById('panelImages').classList.toggle('active', isImages);
    document.getElementById('panelVideos').classList.toggle('active', !isImages);
    document.getElementById('tabImgBtn').setAttribute('aria-selected', isImages ? 'true' : 'false');
    document.getElementById('tabVidBtn').setAttribute('aria-selected', isImages ? 'false' : 'true');
  }

  // ── Drag-and-drop + preview helper (with per-item remove) ───────────────────

  // Holds the current File arrays (since FileList is read-only)
  const fileStore = { images: [], videos: [] };

  function syncInputFiles(input, files) {
    const dt = new DataTransfer();
    files.forEach(f => dt.items.add(f));
    input.files = dt.files;
  }

  function renderPreviews(files, grid, isVideo, storeKey, input, maxCount) {
    grid.innerHTML = '';
    if (!files || files.length === 0) return;
    const limited = files.slice(0, maxCount);
    limited.forEach((file, idx) => {
      const div = document.createElement('div');
      div.className = 'preview-item';
      const url = URL.createObjectURL(file);

      const media = document.createElement(isVideo ? 'video' : 'img');
      media.src = url;
      if (isVideo) media.muted = true;
      div.appendChild(media);

      // ── Remove button ──
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'preview-remove';
      btn.title = 'Remove this file';
      btn.innerHTML = '&times;';
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        fileStore[storeKey].splice(idx, 1);
        syncInputFiles(input, fileStore[storeKey]);
        // Re-check limit after removal
        if (fileStore[storeKey].length <= maxCount) clearError();
        renderPreviews(fileStore[storeKey], grid, isVideo, storeKey, input, maxCount);
      });
      div.appendChild(btn);

      grid.appendChild(div);
    });
  }

  function initDropZone(dropZoneId, inputId, previewGridId, isVideo, storeKey, maxCount) {
    const dropZone    = document.getElementById(dropZoneId);
    const input       = document.getElementById(inputId);
    const previewGrid = document.getElementById(previewGridId);

    input.addEventListener('click', e => e.stopPropagation());
    dropZone.addEventListener('click', () => input.click());

    // ── Error banner helpers ─────────────────────────────────────────────────
    const errorBannerId = storeKey === 'images' ? 'imageErrorBanner' : null;
    const uploadBtn     = storeKey === 'images' ? document.getElementById('uploadImgBtn') : null;

    function showError(msg) {
      if (!errorBannerId) return;
      const banner = document.getElementById(errorBannerId);
      banner.textContent = '⚠️ ' + msg;
      banner.style.display = 'block';
      if (uploadBtn) uploadBtn.disabled = true;
    }
    function clearError() {
      if (!errorBannerId) return;
      const banner = document.getElementById(errorBannerId);
      banner.style.display = 'none';
      banner.textContent = '';
      if (uploadBtn) uploadBtn.disabled = false;
    }

    const handleFiles = (incomingFiles) => {
      const incoming = Array.from(incomingFiles);
      const merged   = [...fileStore[storeKey], ...incoming];

      // ── Hard limit check ──────────────────────────────────────────────────
      if (merged.length > maxCount) {
        showError(`You can only upload up to ${maxCount} images at a time. Currently selected: ${merged.length}. Please remove some before uploading.`);
        // Still show what was already queued — don't add the new batch
        return;
      }

      clearError();
      fileStore[storeKey] = merged;
      syncInputFiles(input, merged);
      renderPreviews(merged, previewGrid, isVideo, storeKey, input, maxCount);
    };

    dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('dragover'); });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
    dropZone.addEventListener('drop', e => {
      e.preventDefault();
      dropZone.classList.remove('dragover');
      if (e.dataTransfer && e.dataTransfer.files.length) handleFiles(e.dataTransfer.files);
    });
    input.addEventListener('change', () => {
      if (input.files && input.files.length) handleFiles(input.files);
    });
  }

  initDropZone('imageDropZone', 'imageInput', 'imagePreviewGrid', false, 'images', 15);
  initDropZone('videoDropZone', 'videoInput', 'videoPreviewGrid', true,  'videos', 5);

  // ── Final submit guard ────────────────────────────────────────────────────
  document.getElementById('imageForm').addEventListener('submit', (e) => {
    if (fileStore.images.length > 15) {
      e.preventDefault();
      document.getElementById('imageErrorBanner').style.display = 'block';
      document.getElementById('imageErrorBanner').textContent =
        '⚠️ Cannot upload more than 15 images at a time. Please remove some and try again.';
    }
  });
</script>
</body>
</html>
