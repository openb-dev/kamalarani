<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/png" href="/images/logo.png">
<link rel="apple-touch-icon" href="/images/logo.png">

<!-- Primary SEO -->
<title>Events Calendar — Kamalarani Foundation | Free Art Classes West Bengal</title>
<meta name="description" content="View upcoming events, art class schedules, and activities organised by Kamalarani Foundation in Coochbehar and North 24 Parganas, West Bengal.">
<meta name="keywords" content="Kamalarani Foundation events, art class schedule, West Bengal NGO events, Coochbehar events, free art class dates">
<meta name="robots" content="index, follow">
<meta name="author" content="Kamalarani Foundation">
<link rel="canonical" href="https://kamalaranifoundation.org/calendar">

<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:url" content="https://kamalaranifoundation.org/calendar">
<meta property="og:title" content="Events Calendar — Kamalarani Foundation">
<meta property="og:description" content="See what's happening at Kamalarani Foundation — art classes, events, and programmes for children in West Bengal.">
<meta property="og:image" content="https://kamalaranifoundation.org/images/photo2.jpeg">
<meta property="og:locale" content="en_IN">

<!-- Breadcrumb JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://kamalaranifoundation.org/" },
    { "@type": "ListItem", "position": 2, "name": "Events Calendar", "item": "https://kamalaranifoundation.org/calendar" }
  ]
}
</script>

<link rel="stylesheet" href="/css/style.css">

<style>
  /* ─────────────────────────────────────────────
     PAGE SHELL
  ───────────────────────────────────────────── */
  .cal-page {
    padding: 60px 0 80px;
  }

  /* shared eyebrow */
  .section-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase;
    color: var(--marigold-deep);
    margin-bottom: 10px;
  }

  /* ─────────────────────────────────────────────
     PAGE HEADER
  ───────────────────────────────────────────── */
  .cal-page-head {
    text-align: center;
    margin-bottom: 52px;
  }
  .cal-page-head h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
    margin-bottom: 10px;
  }
  .cal-page-head p {
    color: var(--ink-soft);
    font-size: 1rem;
    max-width: 500px;
    margin: 0 auto;
  }

  /* ─────────────────────────────────────────────
     UPCOMING EVENTS STRIP
  ───────────────────────────────────────────── */
  .upcoming-section {
    margin-bottom: 60px;
  }
  .upcoming-section-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 22px;
    flex-wrap: wrap;
  }
  .upcoming-section-head h2 {
    font-size: 1.4rem;
  }
  .upcoming-count-pill {
    background: var(--vermilion);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
    padding: 3px 11px;
    border-radius: 999px;
    vertical-align: middle;
  }

  /* horizontal scroll strip on mobile */
  .upcoming-strip {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 16px;
  }
  @media (max-width: 600px) {
    .upcoming-strip {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 14px;
      padding-bottom: 8px;
    }
    .upcoming-strip::-webkit-scrollbar { height: 4px; }
    .upcoming-strip::-webkit-scrollbar-thumb { background: var(--gold-line); border-radius: 4px; }
  }

  .upcoming-card {
    background: linear-gradient(135deg, #0F1B2D 0%, #1b2f4e 100%);
    border-radius: 16px;
    padding: 22px 22px 24px;
    position: relative;
    overflow: hidden;
    transition: transform .2s, box-shadow .2s;
    min-width: 260px;
    scroll-snap-align: start;
  }
  .upcoming-card::before {
    content: '';
    position: absolute;
    top: -30px;
    right: -30px;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: var(--marigold);
    opacity: 0.08;
  }
  .upcoming-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 32px rgba(15,27,45,0.3);
  }

  .upcoming-card-day {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.73rem;
    font-weight: 700;
    letter-spacing: .09em;
    text-transform: uppercase;
    color: var(--marigold);
    margin-bottom: 10px;
  }
  .upcoming-card-title {
    font-family: 'Fraunces', serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: #FFFDF8;
    margin-bottom: 10px;
    line-height: 1.3;
  }
  .upcoming-card-meta {
    font-size: 0.82rem;
    color: rgba(255,253,248,0.65);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .upcoming-card-desc {
    margin-top: 12px;
    font-size: 0.82rem;
    color: rgba(255,253,248,0.55);
    line-height: 1.5;
    border-top: 1px solid rgba(255,253,248,0.1);
    padding-top: 10px;
  }
  /* days-away badge */
  .upcoming-days-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    background: var(--marigold);
    color: var(--ink);
    font-size: 0.67rem;
    font-weight: 800;
    padding: 3px 9px;
    border-radius: 999px;
    letter-spacing: .04em;
  }

  .no-upcoming {
    text-align: center;
    padding: 32px 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
    background: var(--white);
    border-radius: 16px;
    border: 1.5px dashed var(--gold-line);
  }

  /* ─────────────────────────────────────────────
     PAST EVENTS / ARCHIVE SECTION
  ───────────────────────────────────────────── */
  .archive-section {
    margin-top: 64px;
    padding-top: 52px;
    border-top: 1.5px solid var(--temple-cream-2);
  }
  .archive-section-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 26px;
    flex-wrap: wrap;
  }
  .archive-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 0;
  }
  .archive-count-pill {
    background: #6b7280;
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
    padding: 3px 11px;
    border-radius: 999px;
    vertical-align: middle;
  }
  .archive-section h2 {
    font-family: 'Fraunces', serif;
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 6px;
  }
  .archive-section-desc {
    color: var(--ink-soft);
    font-size: 0.9rem;
    margin-bottom: 28px;
  }

  /* Past event cards grid */
  .archive-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .past-card {
    background: #f8f6f1;
    border: 1.5px solid #e5e0d6;
    border-radius: 16px;
    padding: 20px 20px 22px;
    position: relative;
    overflow: hidden;
    transition: transform .2s, box-shadow .2s, opacity .2s;
    opacity: 0.85;
  }
  .past-card::before {
    content: '';
    position: absolute;
    top: -24px;
    right: -24px;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: #9ca3af;
    opacity: 0.07;
  }
  .past-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(0,0,0,0.09);
    opacity: 1;
  }
  .past-card-date-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    background: #6b7280;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 999px;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .past-card-day {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #6b7280;
    margin-bottom: 8px;
  }
  .past-card-title {
    font-family: 'Fraunces', serif;
    font-size: 1rem;
    font-weight: 700;
    color: #374151;
    margin-bottom: 8px;
    line-height: 1.3;
  }
  .past-card-meta {
    font-size: 0.8rem;
    color: #6b7280;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .past-card-desc {
    margin-top: 10px;
    font-size: 0.8rem;
    color: #9ca3af;
    line-height: 1.5;
    border-top: 1px solid #e5e0d6;
    padding-top: 9px;
  }

  /* Show more / collapse toggle */
  .archive-toggle-wrap {
    text-align: center;
    margin-top: 28px;
  }
  .archive-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: 2px solid #d1d5db;
    color: #374151;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 10px 28px;
    border-radius: 999px;
    cursor: pointer;
    transition: all .2s;
    letter-spacing: .03em;
  }
  .archive-toggle-btn:hover {
    border-color: #6b7280;
    background: #f3f4f6;
    transform: translateY(-1px);
  }
  .archive-toggle-btn .toggle-arrow {
    display: inline-block;
    transition: transform .3s;
    font-size: 0.9rem;
  }
  .archive-toggle-btn.expanded .toggle-arrow {
    transform: rotate(180deg);
  }

  /* Hidden past cards (beyond first 6) */
  .past-card.archive-hidden {
    display: none;
  }

  /* ─────────────────────────────────────────────
     DIVIDER
  ───────────────────────────────────────────── */
  .cal-divider {
    border: none;
    border-top: 1.5px solid var(--temple-cream-2);
    margin: 0 0 52px;
  }

  /* ─────────────────────────────────────────────
     YEAR NAVIGATOR
  ───────────────────────────────────────────── */
  .year-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-bottom: 32px;
  }
  .year-nav-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid var(--gold-line);
    background: var(--white);
    color: var(--ink);
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all .2s;
  }
  .year-nav-btn:hover {
    background: #0F1B2D;
    border-color: #0F1B2D;
    color: #FFFDF8;
    transform: scale(1.06);
  }
  .year-nav-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    transform: none;
  }
  #yearLabel {
    font-family: 'Fraunces', serif;
    font-size: 1.9rem;
    font-weight: 700;
    color: var(--ink);
    min-width: 76px;
    text-align: center;
  }

  /* ─────────────────────────────────────────────
     12-MONTH GRID
  ───────────────────────────────────────────── */
  .months-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 36px;
  }
  @media (max-width: 768px) {
    .months-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 480px) {
    .months-grid { grid-template-columns: repeat(2, 1fr); gap: 9px; }
  }

  .month-tile {
    background: var(--white);
    border: 2px solid var(--temple-cream-2);
    border-radius: 14px;
    padding: 16px 10px 15px;
    text-align: center;
    cursor: pointer;
    transition: all .22s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    position: relative;
    overflow: hidden;
    user-select: none;
  }
  .month-tile:hover {
    border-color: var(--marigold);
    transform: translateY(-3px);
    box-shadow: 0 8px 22px rgba(232,145,45,0.18);
  }
  .month-tile.active {
    border-color: #0F1B2D;
    background: linear-gradient(135deg, #0F1B2D 0%, #1a2d4a 100%);
    box-shadow: 0 8px 26px rgba(15,27,45,0.32);
    transform: translateY(-3px);
  }
  .month-tile.active .month-name  { color: #FFFDF8; }
  .month-tile.active .month-event-count { color: var(--marigold); }
  .month-tile.active .month-event-dot span { background: var(--marigold); }

  .month-tile.is-today-month { border-color: var(--gold-line); }
  .month-tile.is-today-month .month-name { color: var(--vermilion); }
  .month-tile.active.is-today-month .month-name { color: #FFFDF8; }

  .month-tile:not(.has-events) { opacity: 0.58; }
  .month-tile:not(.has-events):hover { opacity: 0.8; }

  .month-name {
    font-family: 'Fraunces', serif;
    font-size: 0.97rem;
    font-weight: 700;
    color: var(--ink);
    transition: color .22s;
    display: block;
    margin-bottom: 5px;
  }
  .month-event-count {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-soft);
    transition: color .22s;
    display: block;
  }
  .month-event-dot {
    display: inline-flex;
    gap: 3px;
    margin-top: 7px;
    justify-content: center;
  }
  .month-event-dot span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--marigold);
    display: inline-block;
  }

  /* ─────────────────────────────────────────────
     MONTH EVENTS PANEL (always visible once open)
  ───────────────────────────────────────────── */
  .events-panel {
    background: var(--white);
    border: 1.5px solid var(--gold-line);
    border-radius: 20px;
    padding: 0;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition: max-height .5s cubic-bezier(0.4, 0, 0.2, 1),
                opacity .35s ease,
                padding .4s ease;
  }
  .events-panel.open {
    max-height: 4000px;
    opacity: 1;
    padding: 30px 30px 36px;
  }
  @media (max-width: 600px) {
    .events-panel.open { padding: 18px 15px 24px; }
  }

  .events-panel-header {
    margin-bottom: 26px;
    padding-bottom: 18px;
    border-bottom: 1.5px solid var(--temple-cream-2);
  }
  .events-panel-title {
    font-family: 'Fraunces', serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--ink);
  }
  .events-panel-title em {
    color: var(--marigold-deep);
    font-style: normal;
  }
  .events-panel-sub {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin-top: 4px;
  }

  /* ─────────────────────────────────────────────
     FULL MONTH CALENDAR GRID
  ───────────────────────────────────────────── */
  .month-calendar-wrap {
    margin-bottom: 32px;
  }
  .cal-dow-header {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
    margin-bottom: 4px;
  }
  .cal-dow {
    text-align: center;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: .07em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding: 8px 0 6px;
  }
  .month-calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
    background: var(--temple-cream);
    border-radius: 16px;
    border: 1.5px solid var(--temple-cream-2);
    overflow: hidden;
    padding: 4px;
  }
  .cal-day {
    background: var(--white);
    border-radius: 10px;
    min-height: 78px;
    padding: 7px 7px 6px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: box-shadow .18s, transform .18s;
  }
  .cal-day.empty {
    background: transparent;
    box-shadow: none !important;
    cursor: default;
  }
  .cal-day.has-event {
    cursor: pointer;
    border: 1.5px solid var(--marigold);
    background: linear-gradient(160deg, #fffdf5 0%, #fff8e8 100%);
  }
  .cal-day.has-event:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(232,145,45,0.22);
  }
  .cal-day.has-event.selected-day {
    border-color: #0F1B2D;
    background: linear-gradient(160deg, #0F1B2D 0%, #1a2d4a 100%);
  }
  .cal-day.has-event.selected-day .cal-day-num { color: #FFFDF8; }
  .cal-day.has-event.selected-day .cal-day-event-chip {
    background: rgba(255,253,248,0.15);
    color: #FFFDF8;
  }
  .cal-day.is-today:not(.empty) {
    box-shadow: inset 0 0 0 2px var(--vermilion);
  }
  .cal-day.is-today .cal-day-num {
    color: var(--vermilion);
    font-weight: 800;
  }
  .cal-day-num {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1;
    margin-bottom: 5px;
    transition: color .18s;
  }
  .cal-day-num.weekend { color: var(--ink-soft); }
  .cal-day-events {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
    overflow: hidden;
  }
  .cal-day-event-chip {
    font-size: 0.63rem;
    font-weight: 600;
    background: rgba(232,145,45,0.14);
    color: var(--marigold-deep);
    border-radius: 4px;
    padding: 2px 5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: background .18s, color .18s;
  }
  .cal-day-more {
    font-size: 0.6rem;
    color: var(--marigold-deep);
    font-weight: 700;
    margin-top: 1px;
  }
  @media (max-width: 600px) {
    .cal-day { min-height: 54px; padding: 5px 4px 4px; }
    .cal-day-event-chip { display: none; }
    .cal-day-num { font-size: 0.76rem; }
    .cal-day.has-event::after {
      content: '';
      display: block;
      width: 5px; height: 5px;
      border-radius: 50%;
      background: var(--marigold);
      margin: 3px auto 0;
    }
    .cal-day.has-event.selected-day::after { background: #FFFDF8; }
  }

  /* ─────────────────────────────────────────────
     DAY DETAIL DRAWER
  ───────────────────────────────────────────── */
  .day-detail-drawer {
    background: var(--temple-cream);
    border: 1.5px solid var(--gold-line);
    border-radius: 16px;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition: max-height .4s cubic-bezier(0.4, 0, 0.2, 1), opacity .3s ease, margin .3s ease, padding .3s ease;
    padding: 0 24px;
    margin-top: 0;
  }
  .day-detail-drawer.open {
    max-height: 600px;
    opacity: 1;
    padding: 22px 24px 26px;
    margin-top: 16px;
  }
  @media (max-width: 600px) {
    .day-detail-drawer.open { padding: 16px 14px 20px; }
  }
  .day-detail-heading {
    font-family: 'Fraunces', serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 1.5px solid var(--temple-cream-2);
  }
  .day-detail-heading span { color: var(--marigold-deep); }
  .day-detail-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .day-detail-item {
    background: var(--white);
    border-radius: 12px;
    border-left: 4px solid var(--marigold);
    padding: 14px 16px 15px;
    animation: cardIn .3s cubic-bezier(0.25,0.46,0.45,0.94) both;
  }
  @keyframes cardIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .day-detail-item-time {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--marigold-deep);
    letter-spacing: .05em;
    text-transform: uppercase;
    margin-bottom: 5px;
  }
  .day-detail-item-title {
    font-family: 'Fraunces', serif;
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
    margin-bottom: 6px;
  }
  .day-detail-item-meta {
    font-size: 0.8rem;
    color: var(--ink-soft);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .day-detail-item-desc {
    margin-top: 8px;
    font-size: 0.82rem;
    color: var(--ink-soft);
    line-height: 1.5;
    border-top: 1px solid var(--temple-cream-2);
    padding-top: 8px;
  }
  .day-detail-badge {
    display: inline-block;
    background: var(--vermilion);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: .04em;
    margin-left: 8px;
    vertical-align: middle;
  }
  .day-detail-badge.past { background: var(--ink-soft); }

  /* no events state */
  .no-events-state {
    text-align: center;
    padding: 28px 0;
    color: var(--ink-soft);
  }
  .no-events-state .no-events-icon { font-size: 2.2rem; margin-bottom: 8px; }
  .no-events-state p { font-size: 0.92rem; }
</style>
</head>
<body>
<a href="#main-content" class="skip-link">Skip to main content</a>
<%- include('partials/header') %>

<main id="main-content">
<section class="cal-page" aria-labelledby="cal-page-heading">
<div class="wrap">

  <!-- ── PAGE HEADER ─────────────────────────── -->
  <div class="cal-page-head">
    <div class="section-eyebrow">📅 Kamalarani Foundation</div>
    <h1 id="cal-page-heading">Events Calendar</h1>
    <p>Browse all months and upcoming events at Kamalarani Foundation.</p>
  </div>

  <!-- ── UPCOMING EVENTS SECTION ────────────── -->
  <div class="upcoming-section" id="upcomingSection">
    <div class="upcoming-section-head">
      <div class="section-eyebrow" style="margin-bottom:0;">Upcoming Events</div>
      <span class="upcoming-count-pill" id="upcomingCountPill"></span>
    </div>
    <div class="upcoming-strip" id="upcomingStrip">
      <!-- Injected by JS -->
    </div>
  </div>

  <hr class="cal-divider">

  <!-- ── CALENDAR BROWSER ────────────────────── -->
  <div style="text-align:center;margin-bottom:10px;">
    <div class="section-eyebrow">Browse by Month</div>
  </div>

  <!-- Year navigator -->
  <div class="year-nav" role="group" aria-label="Year navigation">
    <button class="year-nav-btn" id="prevYearBtn" aria-label="Previous year">&#8592;</button>
    <span id="yearLabel" aria-live="polite"></span>
    <button class="year-nav-btn" id="nextYearBtn" aria-label="Next year">&#8594;</button>
  </div>

  <!-- 12-month grid -->
  <div class="months-grid" id="monthsGrid" role="list" aria-label="Select a month to view its events"></div>

  <!-- Events reveal panel -->
  <div class="events-panel" id="eventsPanel" role="region" aria-label="Events for selected month" aria-live="polite">
    <div class="events-panel-header">
      <div class="events-panel-title" id="eventsPanelTitle">Events</div>
      <div class="events-panel-sub" id="eventsPanelSub"></div>
    </div>

    <!-- Full Month Calendar Grid -->
    <div class="month-calendar-wrap" id="monthCalendarWrap">
      <div class="cal-dow-header" id="calDowHeader"></div>
      <div class="month-calendar-grid" id="monthCalendarGrid"></div>
    </div>

    <!-- Day Detail Drawer -->
    <div class="day-detail-drawer" id="dayDetailDrawer" aria-live="polite">
      <div class="day-detail-heading" id="dayDetailHeading"></div>
      <div class="day-detail-list" id="dayDetailList"></div>
    </div>
  </div>

  <!-- ── PAST EVENTS / ARCHIVE SECTION ────────────── -->
  <div class="archive-section" id="archiveSection" style="display:none;">
    <div class="archive-section-head">
      <div class="archive-eyebrow">🗂️ Archive</div>
      <span class="archive-count-pill" id="archiveCountPill"></span>
    </div>
    <h2>Past Events</h2>
    <p class="archive-section-desc">A record of events and programmes that have already taken place.</p>
    <div class="archive-grid" id="archiveGrid">
      <!-- Injected by JS -->
    </div>
    <div class="archive-toggle-wrap" id="archiveToggleWrap" style="display:none;">
      <button class="archive-toggle-btn" id="archiveToggleBtn" aria-expanded="false">
        <span id="archiveToggleLabel">Show all past events</span>
        <span class="toggle-arrow">&#8964;</span>
      </button>
    </div>
  </div>

</div>
</section>
</main>

<%- include('partials/footer') %>

<script>
(function () {

  /* ── Raw data from server ───────────────────────────────────── */
  const RAW_EVENTS = <%- JSON.stringify(events.map(function(ev) {
    return {
      id:          ev.id,
      title:       ev.title,
      description: ev.description || '',
      location:    ev.location    || '',
      event_date:  ev.event_date,
      end_date:    ev.end_date || null
    };
  })) %>;

  const EVENTS = RAW_EVENTS.map(function(ev) {
    return Object.assign({}, ev, {
      dateObj: new Date(ev.event_date),
      endObj:  ev.end_date ? new Date(ev.end_date) : null
    });
  });

  /* ── Constants ──────────────────────────────────────────────── */
  const MONTH_NAMES = [
    'January','February','March','April','May','June',
    'July','August','September','October','November','December'
  ];
  const DOW_SHORT = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];

  const today = new Date();
  today.setHours(0, 0, 0, 0);

  /* year bounds */
  var minYear = today.getFullYear();
  var maxYear = today.getFullYear() + 1;
  if (EVENTS.length) {
    EVENTS.forEach(function(e) {
      var y = e.dateObj.getFullYear();
      if (y < minYear) minYear = y;
      if (y > maxYear) maxYear = y;
    });
  }

  var currentYear   = today.getFullYear();
  var selectedMonth = null;
  var selectedDay   = null;

  /* ── DOM refs ───────────────────────────────────────────────── */
  var yearLabel         = document.getElementById('yearLabel');
  var prevYearBtn       = document.getElementById('prevYearBtn');
  var nextYearBtn       = document.getElementById('nextYearBtn');
  var monthsGrid        = document.getElementById('monthsGrid');
  var eventsPanel       = document.getElementById('eventsPanel');
  var eventsPanelTitle  = document.getElementById('eventsPanelTitle');
  var eventsPanelSub    = document.getElementById('eventsPanelSub');
  var calDowHeader      = document.getElementById('calDowHeader');
  var monthCalGrid      = document.getElementById('monthCalendarGrid');
  var dayDetailDrawer   = document.getElementById('dayDetailDrawer');
  var dayDetailHeading  = document.getElementById('dayDetailHeading');
  var dayDetailList     = document.getElementById('dayDetailList');
  var upcomingStrip     = document.getElementById('upcomingStrip');
  var upcomingCountPill = document.getElementById('upcomingCountPill');

  /* ── Helpers ────────────────────────────────────────────────── */
  function eventsForMonth(year, month) {
    return EVENTS.filter(function(ev) {
      return ev.dateObj.getFullYear() === year && ev.dateObj.getMonth() === month;
    });
  }
  function eventsForDay(year, month, day) {
    return EVENTS.filter(function(ev) {
      return ev.dateObj.getFullYear() === year &&
             ev.dateObj.getMonth()    === month &&
             ev.dateObj.getDate()     === day;
    });
  }

  function formatDateShort(d) {
    return d.toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short' });
  }
  function formatTime(d) {
    var h = d.getHours(), m = d.getMinutes();
    if (h === 0 && m === 0) return '';
    return d.toLocaleTimeString('en-IN', { hour: 'numeric', minute: '2-digit', hour12: true });
  }
  function daysFromNow(d) {
    var diff = Math.ceil((d - today) / 86400000);
    if (diff === 0) return 'Today';
    if (diff === 1) return 'Tomorrow';
    return 'In ' + diff + ' days';
  }

  /* ── DOM refs (archive) ─────────────────────────────────────── */
  var archiveSection    = document.getElementById('archiveSection');
  var archiveCountPill  = document.getElementById('archiveCountPill');
  var archiveGrid       = document.getElementById('archiveGrid');
  var archiveToggleWrap = document.getElementById('archiveToggleWrap');
  var archiveToggleBtn  = document.getElementById('archiveToggleBtn');
  var archiveToggleLabel= document.getElementById('archiveToggleLabel');

  /* ── UPCOMING STRIP (all future events) ─────────────────────── */
  function renderUpcoming() {
    var upcoming = EVENTS.filter(function(ev) {
      return ev.dateObj >= today;
    }).sort(function(a, b) { return a.dateObj - b.dateObj; });

    upcomingCountPill.textContent = upcoming.length + (upcoming.length === 1 ? ' event' : ' events');

    if (upcoming.length === 0) {
      upcomingStrip.innerHTML =
        '<div class="no-upcoming">🗓️ &nbsp;No upcoming events right now — check back soon.</div>';
      return;
    }

    upcomingStrip.innerHTML = '';
    upcoming.forEach(function(ev, i) {
      var timeStr = formatTime(ev.dateObj);
      var days    = daysFromNow(ev.dateObj);
      var card = document.createElement('article');
      card.className = 'upcoming-card';
      card.style.animationDelay = (i * 0.05) + 's';
      var dateLabel = formatDateShort(ev.dateObj) + (timeStr ? ' · ' + timeStr : '');
      var metaHtml = ev.location ? '<span>📍 ' + ev.location + '</span>' : '';
      var descHtml = ev.description ? '<div class="upcoming-card-desc">' + ev.description + '</div>' : '';
      card.innerHTML =
        '<span class="upcoming-days-badge">' + days + '</span>' +
        '<div class="upcoming-card-day">' + dateLabel + '</div>' +
        '<div class="upcoming-card-title">' + ev.title + '</div>' +
        '<div class="upcoming-card-meta">' + metaHtml + '</div>' +
        descHtml;
      upcomingStrip.appendChild(card);
    });
  }

  /* ── PAST EVENTS / ARCHIVE ──────────────────────────────────── */
  var ARCHIVE_PAGE_SIZE = 6;
  var archiveExpanded   = false;

  function renderArchive() {
    var past = EVENTS.filter(function(ev) {
      return ev.dateObj < today;
    }).sort(function(a, b) { return b.dateObj - a.dateObj; }); /* newest first */

    if (past.length === 0) {
      archiveSection.style.display = 'none';
      return;
    }

    archiveSection.style.display = '';
    archiveCountPill.textContent = past.length + (past.length === 1 ? ' event' : ' events');
    archiveGrid.innerHTML = '';

    past.forEach(function(ev, i) {
      var timeStr  = formatTime(ev.dateObj);
      var dateLabel = formatDateShort(ev.dateObj) + (timeStr ? ' · ' + timeStr : '');
      var metaHtml  = ev.location ? '<span>📍 ' + ev.location + '</span>' : '';
      var descHtml  = ev.description ? '<div class="past-card-desc">' + ev.description + '</div>' : '';

      /* How long ago */
      var daysAgo = Math.round((today - ev.dateObj) / 86400000);
      var agoStr  = daysAgo === 0 ? 'Yesterday'
                  : daysAgo === 1 ? '1 day ago'
                  : daysAgo < 30  ? daysAgo + ' days ago'
                  : daysAgo < 365 ? Math.round(daysAgo / 30) + ' mo ago'
                  : Math.round(daysAgo / 365) + ' yr ago';

      var card = document.createElement('article');
      card.className = 'past-card' + (i >= ARCHIVE_PAGE_SIZE ? ' archive-hidden' : '');
      card.innerHTML =
        '<span class="past-card-date-badge">' + agoStr + '</span>' +
        '<div class="past-card-day">📅 ' + dateLabel + '</div>' +
        '<div class="past-card-title">' + ev.title + '</div>' +
        '<div class="past-card-meta">' + metaHtml + '</div>' +
        descHtml;
      archiveGrid.appendChild(card);
    });

    /* Show toggle only if more than page size */
    if (past.length > ARCHIVE_PAGE_SIZE) {
      archiveToggleWrap.style.display = '';
      archiveToggleLabel.textContent  = 'Show all ' + past.length + ' past events';
      archiveToggleBtn.classList.remove('expanded');
      archiveToggleBtn.setAttribute('aria-expanded', 'false');
      archiveExpanded = false;
    } else {
      archiveToggleWrap.style.display = 'none';
    }
  }

  archiveToggleBtn.addEventListener('click', function() {
    archiveExpanded = !archiveExpanded;
    var hidden = archiveGrid.querySelectorAll('.archive-hidden');
    hidden.forEach(function(el) { el.style.display = archiveExpanded ? '' : 'none'; });
    /* Reset display for initial hidden cards */
    archiveGrid.querySelectorAll('.past-card').forEach(function(el, i) {
      el.style.display = (!archiveExpanded && i >= ARCHIVE_PAGE_SIZE) ? 'none' : '';
    });
    archiveToggleBtn.setAttribute('aria-expanded', archiveExpanded ? 'true' : 'false');
    archiveToggleBtn.classList.toggle('expanded', archiveExpanded);
    archiveToggleLabel.textContent = archiveExpanded
      ? 'Show fewer past events'
      : 'Show all past events';
    if (!archiveExpanded) {
      archiveSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  /* ── MONTH TILE GRID ────────────────────────────────────────── */
  function renderMonthGrid() {
    yearLabel.textContent  = currentYear;
    prevYearBtn.disabled   = (currentYear <= minYear);
    nextYearBtn.disabled   = (currentYear >= maxYear);
    monthsGrid.innerHTML   = '';

    for (var m = 0; m < 12; m++) {
      var evs       = eventsForMonth(currentYear, m);
      var hasEvents = evs.length > 0;
      var isCurrent = (currentYear === today.getFullYear() && m === today.getMonth());
      var isActive  = (selectedMonth === m);

      var tile = document.createElement('div');
      tile.className = 'month-tile' +
        (hasEvents ? ' has-events'     : '') +
        (isCurrent ? ' is-today-month' : '') +
        (isActive  ? ' active'         : '');
      tile.setAttribute('role', 'listitem');
      tile.setAttribute('tabindex', '0');
      tile.setAttribute('aria-label',
        MONTH_NAMES[m] + ' ' + currentYear +
        (hasEvents ? ' — ' + evs.length + ' event' + (evs.length > 1 ? 's' : '') : ' — no events') +
        (isActive ? ', currently selected' : ''));
      tile.dataset.month = m;

      var dots = '';
      if (hasEvents) {
        var dotCount = Math.min(evs.length, 3);
        dots = '<span class="month-event-dot">';
        for (var d = 0; d < dotCount; d++) dots += '<span></span>';
        dots += '</span>';
      }

      tile.innerHTML =
        '<span class="month-name">' + MONTH_NAMES[m] + '</span>' +
        '<span class="month-event-count">' +
          (hasEvents ? evs.length + ' event' + (evs.length > 1 ? 's' : '') : 'No events') +
        '</span>' + dots;

      tile.addEventListener('click', function() {
        var idx = parseInt(this.dataset.month, 10);
        selectedMonth = idx;
        selectedDay   = null;
        renderMonthGrid();
        openPanel(idx);
      });
      tile.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); this.click(); }
      });
      monthsGrid.appendChild(tile);
    }
  }

  /* ── FULL MONTH CALENDAR GRID ───────────────────────────────── */
  function renderMonthCalendar(year, monthIdx) {
    /* Day-of-week headers */
    calDowHeader.innerHTML = '';
    DOW_SHORT.forEach(function(d) {
      var h = document.createElement('div');
      h.className = 'cal-dow';
      h.textContent = d;
      calDowHeader.appendChild(h);
    });

    monthCalGrid.innerHTML = '';
    var firstDay  = new Date(year, monthIdx, 1).getDay();
    var daysInMon = new Date(year, monthIdx + 1, 0).getDate();

    /* Leading empty cells */
    for (var e = 0; e < firstDay; e++) {
      var empty = document.createElement('div');
      empty.className = 'cal-day empty';
      monthCalGrid.appendChild(empty);
    }

    /* Day cells */
    for (var day = 1; day <= daysInMon; day++) {
      var dayEvs  = eventsForDay(year, monthIdx, day);
      var hasEvs  = dayEvs.length > 0;
      var isToday = (year === today.getFullYear() && monthIdx === today.getMonth() && day === today.getDate());
      var isSel   = (hasEvs && selectedDay === day);
      var dow     = new Date(year, monthIdx, day).getDay();

      var cell = document.createElement('div');
      cell.className = 'cal-day' +
        (hasEvs  ? ' has-event'    : '') +
        (isToday ? ' is-today'     : '') +
        (isSel   ? ' selected-day' : '');
      cell.dataset.day = day;

      var numSpan = document.createElement('span');
      numSpan.className = 'cal-day-num' + (dow === 0 || dow === 6 ? ' weekend' : '');
      numSpan.textContent = day;
      cell.appendChild(numSpan);

      if (hasEvs) {
        var chipsWrap = document.createElement('div');
        chipsWrap.className = 'cal-day-events';
        var maxChips = 2;
        dayEvs.slice(0, maxChips).forEach(function(ev) {
          var chip = document.createElement('span');
          chip.className = 'cal-day-event-chip';
          chip.textContent = ev.title;
          chipsWrap.appendChild(chip);
        });
        if (dayEvs.length > maxChips) {
          var more = document.createElement('span');
          more.className = 'cal-day-more';
          more.textContent = '+' + (dayEvs.length - maxChips) + ' more';
          chipsWrap.appendChild(more);
        }
        cell.appendChild(chipsWrap);

        /* Click handler */
        (function(d, evsList, cellEl) {
          cellEl.addEventListener('click', function() {
            var prevSel = monthCalGrid.querySelector('.selected-day');
            if (prevSel) prevSel.classList.remove('selected-day');
            if (selectedDay === d) {
              selectedDay = null;
              dayDetailDrawer.classList.remove('open');
            } else {
              selectedDay = d;
              cellEl.classList.add('selected-day');
              showDayDrawer(year, monthIdx, d, evsList);
            }
          });
        })(day, dayEvs, cell);
      }

      monthCalGrid.appendChild(cell);
    }
  }

  /* ── DAY DETAIL DRAWER ──────────────────────────────────────── */
  function showDayDrawer(year, monthIdx, day, evs) {
    var dateObj = new Date(year, monthIdx, day);
    var dateStr = dateObj.toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    dayDetailHeading.innerHTML = '📅 Events on <span>' + dateStr + '</span>';
    dayDetailList.innerHTML = '';

    evs.forEach(function(ev, i) {
      var isUpcoming = ev.dateObj >= today;
      var timeStr    = formatTime(ev.dateObj);
      var endStr     = ev.endObj ? formatTime(ev.endObj) : '';
      var item = document.createElement('div');
      item.className = 'day-detail-item';
      item.style.animationDelay = (i * 0.07) + 's';
      var timeDisplay = timeStr ? timeStr + (endStr ? ' – ' + endStr : '') : (endStr ? 'Ends ' + endStr : '');
      var badge = '<span class="day-detail-badge' + (isUpcoming ? '' : ' past') + '">' +
        (isUpcoming ? 'Upcoming' : 'Past') + '</span>';
      var metaHtml = ev.location ? '<span>📍 ' + ev.location + '</span>' : '';
      var descHtml = ev.description ? '<div class="day-detail-item-desc">' + ev.description + '</div>' : '';
      item.innerHTML =
        (timeDisplay
          ? '<div class="day-detail-item-time">' + timeDisplay + badge + '</div>'
          : '<div style="margin-bottom:6px;">' + badge + '</div>') +
        '<div class="day-detail-item-title">' + ev.title + '</div>' +
        '<div class="day-detail-item-meta">' + metaHtml + '</div>' +
        descHtml;
      dayDetailList.appendChild(item);
    });

    dayDetailDrawer.classList.add('open');
    setTimeout(function() {
      dayDetailDrawer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }, 80);
  }

  /* ── OPEN PANEL ─────────────────────────────────────────────── */
  function openPanel(monthIdx) {
    var evs = eventsForMonth(currentYear, monthIdx);
    eventsPanelTitle.innerHTML =
      'Events in <em>' + MONTH_NAMES[monthIdx] + ' ' + currentYear + '</em>';
    eventsPanelSub.textContent =
      evs.length + ' event' + (evs.length !== 1 ? 's' : '') + ' scheduled — click a highlighted date to view details';

    dayDetailDrawer.classList.remove('open');
    selectedDay = null;

    renderMonthCalendar(currentYear, monthIdx);
    eventsPanel.classList.add('open');

    setTimeout(function() {
      eventsPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }, 100);
  }

  /* ── YEAR NAV ────────────────────────────────────────────────── */
  prevYearBtn.addEventListener('click', function() {
    if (currentYear > minYear) {
      currentYear--;
      selectedMonth = null;
      selectedDay   = null;
      eventsPanel.classList.remove('open');
      dayDetailDrawer.classList.remove('open');
      renderMonthGrid();
    }
  });

  nextYearBtn.addEventListener('click', function() {
    if (currentYear < maxYear) {
      currentYear++;
      selectedMonth = null;
      selectedDay   = null;
      eventsPanel.classList.remove('open');
      dayDetailDrawer.classList.remove('open');
      renderMonthGrid();
    }
  });

  /* ── INIT ────────────────────────────────────────────────────── */
  renderUpcoming();
  renderArchive();
  renderMonthGrid();

  /* Auto-open current month if it has events */
  var curEvs = eventsForMonth(today.getFullYear(), today.getMonth());
  if (curEvs.length > 0) {
    selectedMonth = today.getMonth();
    renderMonthGrid();
    openPanel(today.getMonth());
  }

})();
</script>
</body>
</html>
